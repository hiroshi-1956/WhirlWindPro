-- ========================================================
-- 1. 画面パーツ基本マスタ (m_parts)
--    新規画面パーツ登録画面の基本情報（パーツ名、サイズ等）を保持
-- ========================================================
CREATE TABLE m_parts (
    parts_id            INT AUTO_INCREMENT PRIMARY KEY, -- 💡 INT + AUTO_INCREMENT に統一
    parts_name          VARCHAR(100) NOT NULL,
    parts_description   TEXT,
    rows_count          INT NOT NULL DEFAULT 1,
    cols_count          INT NOT NULL DEFAULT 1,
    created_at          TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at          TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ========================================================
-- 2. 画面パーツ詳細配置マスタ (m_parts_info)
--    各マス [r,c] ごとの種別や、P_SingleRecordInput.view で設定した情報を保持
-- ========================================================
CREATE TABLE m_parts_info (
    parts_info_id       INT AUTO_INCREMENT PRIMARY KEY,
    parts_id            INT NOT NULL,                   -- 💡 親の parts_id と完全にデータ型を一致させる
    row_pos             INT NOT NULL,
    col_pos             INT NOT NULL,
    layout_type         VARCHAR(50),
    
    -- P_SingleRecordInput.view の詳細情報
    table_id            INT,
    table_name_text     VARCHAR(200),
    preview_title       VARCHAR(100),
    display_label       VARCHAR(20) DEFAULT 'physical',
    column_filter       VARCHAR(20) DEFAULT 'all',
    checked_columns_json TEXT,                          -- MySQL 5.7以降なら JSON 型にしてもOKです
    
    created_at          TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at          TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    
    -- 整合性制約：同じパーツ内で座標の重複を許さない
    CONSTRAINT uq_parts_position UNIQUE (parts_id, row_pos, col_pos),
    -- 外部キー制約：型が完全に一致したため、これで正常に作成できます
    CONSTRAINT fk_m_parts FOREIGN KEY (parts_id) REFERENCES m_parts(parts_id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;


