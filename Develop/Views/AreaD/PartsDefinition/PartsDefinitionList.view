<style>
/* 1. 全体コンテナ */
.db-list-container {
    width: 100%;
    height: 99%;
    margin: 0px auto;
    display: flex;
    flex-direction: column;
    background-color: #ffffff; 
    color: #333;
    font-size: 16px;
    border: 1px solid #ccc;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
}

/* 2. 先頭：タイトルエリア */
.db-main-title {
    padding: 10px 10px;
    font-size: 1.00em;
    font-weight: bold;
    background-color: #2c3e50; 
    color: #ecf0f1;
    border-bottom: 1px solid #1a252f;
    text-align: center;
}

/* 3. アクションエリア */
.db-action-area {
    padding: 20px 15px;
}

.btn-new-registration {
    width: 100%;
    padding: 8px 8px;
    background-color: #3498db; 
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-weight: bold;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    font-size: 0.95em; 
}

/* 4. 一覧エリア */
.db-list-scroll {
    overflow-y: auto;
    flex: 1;
}

.list-label {
    padding: 10px 15px;
    font-size: 0.85em;
    color: #777;
    font-weight: bold;
    background-color: #f9f9f9;
}

.db-table-card {
    padding: 8px 15px;
    border-bottom: 1px solid #eee;
    cursor: pointer;
    background-color: #ffffff;
}

.db-table-card:hover {
    background-color: #f0f7ff;
}

.db-table-card .physical-name {
    font-family: 'Consolas', monospace;
    font-weight: bold;
    color: #000;
    font-size: 1.1em;
    display: block;
    margin-bottom: 4px;
}

.db-table-card .logical-name {
    font-family: 'Consolas', monospace;
    font-weight: bold;
    color: #000;
    font-size: 0.95em;
    display: block;
    margin-bottom: 2px;
}

/* 5. 💡 パーツサイズを表すバッジ */
.table-type-badge {
    font-size: 0.75em;
    padding: 2px 6px;
    border-radius: 3px;
    color: #fff;
    font-weight: bold;
    margin-right: 14px;
    vertical-align: middle;
    display: inline-block;
}

/* データがない時のメッセージ */
.no-data-msg {
    padding: 30px 15px;
    text-align: center;
    color: #999;
    font-size: 0.9em;
}
</style>

<div class="db-list-container">
    <div class="db-main-title">画面パーツ定義</div>

    <div class="db-action-area">
        <button class="btn-new-registration" onclick="bridge({ code: 'PartsDefinition/newParts' });">
            <span>+</span> 画面パーツ定義新規登録
        </button>
    </div>
    
    <div class="db-list-scroll">
        <div class="list-label">登録済み画面パーツ定義一覧</div>
        
        <?php 
        if (!empty($parts_list) && is_array($parts_list)): 
            foreach ($parts_list as $parts): 
                $partsId   = htmlspecialchars($parts['parts_id'] ?? '', ENT_QUOTES);
                $partsName = htmlspecialchars($parts['parts_name'] ?? '', ENT_QUOTES);
                $partsType = htmlspecialchars($parts['parts_type'] ?? '', ENT_QUOTES);
                $desc      = htmlspecialchars($parts['parts_description'] ?? '', ENT_QUOTES);
                
                // 💡 先頭文字から色を生成するロジック
                // 先頭1文字の文字コードを取得し、それを色相(Hue)に変換します
                $firstChar = mb_substr($partsType, 0, 1, 'UTF-8');
                $code = mb_ord($firstChar, 'UTF-8');
                // 137は素数で、色相をランダムに散らすための係数です
                $hue = ($code * 137) % 360; 
                // 彩度60%、輝度45%で視認性の高い色を作ります
                $style = "background-color: hsl($hue, 60%, 45%);";
        ?>
            <div class="db-table-card" onclick="bridge({ code: 'PartsDefinition/editParts', parts_id: '<?php echo $partsId; ?>' });">
                <span class="physical-name"><?php echo $partsName; ?></span>
                <span class="logical-name">
                    <?php if ($partsType !== ''): ?>
                        <span class="table-type-badge" style="<?php echo $style; ?>"><?php echo $partsType; ?></span>
                    <?php endif; ?>
                    
                    <?php echo $desc ?: '（説明なし）'; ?>
                </span>
            </div>
        <?php 
            endforeach; 
        else: 
        ?>
            <div class="no-data-msg">登録済みの画面パーツ定義はありません。</div>
        <?php endif; ?>
    </div>
</div>