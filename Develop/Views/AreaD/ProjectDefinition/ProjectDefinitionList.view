<style>
/* 1. 全体コンテナ */
.db-list-container {
    width: 100%;       /* 💡 幅を100%に調整 */
    height: 99%;       /* 高さを画面の約2/3に固定 */
    margin: 0px auto;  /* 中央配置 */
    display: flex;
    flex-direction: column;
    background-color: #ffffff; 
    color: #333;
    font-size: 16px;    
    border: 1px solid #ccc;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1); 
}

/* 2. 先頭：タイトルエリア */
.db-main-title {
    padding: 10px 10px; 
    font-size: 1.00em;  
    font-weight: bold;
    background-color: #2c3e50; 
    color: #ecf0f1;
    border-bottom: 1px solid #1a252f;
    text-align: center; 
}

/* 4. 一覧エリア */
.db-list-scroll {
    overflow-y: auto;
    flex: 1;
}

.list-label {
    padding: 10px 15px;
    font-size: 0.85em;  
    color: #777;
    font-weight: bold;
    background-color: #f9f9f9;
}

.db-table-card {
    padding: 15px;      
    border-bottom: 1px solid #eee;
    cursor: pointer;
    background-color: #ffffff;
}

.db-table-card:hover {
    background-color: #f0f7ff;
}

.db-table-card .physical-name {
    font-family: 'Consolas', monospace;
    font-weight: bold;
    color: #000;
    font-size: 1.1em;   
    display: block;
    margin-bottom: 4px;
}

.db-table-card .logical-name {
    font-size: 0.95em;  
    color: #555;
}
</style>

<div class="db-list-container">
    <div class="db-main-title">プロジェクト定義</div>
    
    <div class="db-list-scroll">
        <div class="list-label">登録済みプロジェクト一覧</div>
        
        <?php if (!empty($projectList) && is_array($projectList)): ?>
            <?php foreach ($projectList as $project): ?>
                <div class="db-table-card" onclick="bridge({ code: 'ProjectDefinition/projectDetail', id: '<?= htmlspecialchars($project['project_id'], ENT_QUOTES, 'UTF-8') ?>' });">
                    <span class="physical-name"><?= htmlspecialchars($project['project_id'], ENT_QUOTES, 'UTF-8') ?></span>
                    <span class="logical-name"><?= htmlspecialchars($project['project_name'], ENT_QUOTES, 'UTF-8') ?></span>
                </div>
            <?php endforeach; ?>
        <?php else: ?>
            <div style="padding: 20px; color: #95a5a6; font-size: 0.9em; text-align: center;">
                登録されているプロジェクトがありません。
            </div>
        <?php endif; ?>
    </div>
</div>