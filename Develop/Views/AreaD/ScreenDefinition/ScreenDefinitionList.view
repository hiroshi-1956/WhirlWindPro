<style>
/* 1. 全体コンテナ */
.db-list-container {
    width: 100%;       
    height: 99%;       
    margin: 0px auto;  
    display: flex;
    flex-direction: column;
    background-color: #ffffff; 
    color: #333;
    font-size: 16px;    
    border: 1px solid #ccc;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1); 
}

/* 2. 先頭：タイトルエリア */
.db-main-title {
    padding: 10px 10px; 
    font-size: 1.00em;  
    font-weight: bold;
    background-color: #2c3e50; 
    color: #ecf0f1;
    border-bottom: 1px solid #1a252f;
    text-align: center; 
}

/* 3. アクションエリア */
.db-action-area {
    padding: 20px 15px;
}

.btn-new-registration {
    width: 100%;
    padding: 8px 8px;
    background-color: #3498db; 
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-weight: bold;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    font-size: 0.95em; 
}

/* 4. 一覧エリア */
.db-list-scroll {
    overflow-y: auto;
    flex: 1;
}

.list-label {
    padding: 10px 15px;
    font-size: 0.85em;  
    color: #777;
    font-weight: bold;
    background-color: #f9f9f9;
}

.db-table-card {
    padding: 15px;      
    border-bottom: 1px solid #eee;
    cursor: pointer;
    background-color: #ffffff;
}

.db-table-card:hover {
    background-color: #f0f7ff;
}

.db-table-card .physical-name {
    font-family: 'Consolas', monospace;
    font-weight: bold;
    color: #000;
    font-size: 1.1em;   
    display: block;
    margin-bottom: 4px;
}

.db-table-card .logical-name {
    font-size: 0.95em;  
    color: #555;
}

.no-data-msg {
    padding: 15px;
    color: #666;
    font-style: italic;
    text-align: center;
}
</style>

<div class="db-list-container">
    <div class="db-main-title">画面定義</div>

    <div class="db-action-area">
        <button class="btn-new-registration" onclick="bridge({ code: 'ScreenDefinition/newScreen', project_id: '<?php echo htmlspecialchars($project_id ?? '', ENT_QUOTES, 'UTF-8'); ?>' });">
            <span>+</span> 画面定義新規登録
        </button>
    </div>
    
    <div class="db-list-scroll">
        <div class="list-label">登録済み画面定義一覧</div>
        
        <?php 
        if (!empty($screen_list) && is_array($screen_list)): 
            foreach ($screen_list as $screen): 
                $screenId   = htmlspecialchars($screen['screen_id'] ?? '', ENT_QUOTES, 'UTF-8');
                $screenName = htmlspecialchars($screen['screen_name'] ?? '', ENT_QUOTES, 'UTF-8');
                $desc       = htmlspecialchars($screen['screen_description'] ?? '', ENT_QUOTES, 'UTF-8');
        ?>
        	<div class="db-table-card" onclick="bridge({ code: 'ScreenDefinition/edit', project_id: '<?php echo htmlspecialchars($project_id ?? '', ENT_QUOTES, 'UTF-8'); ?>', screen_id: '<?php echo $screenId; ?>' });">
                <span class="physical-name"><?php echo $screenName; ?></span>
                <span class="logical-name">
                    <?php echo $desc ?: '（説明なし）'; ?>
                </span>
            </div>
        <?php 
            endforeach; 
        else: 
        ?>
            <div class="no-data-msg">登録済みの画面定義はありません。</div>
        <?php endif; ?>
    </div>
</div>
