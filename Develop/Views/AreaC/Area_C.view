<style>
    #area-c-content { height: 100%; overflow-y: auto; background-color: #2c3e50; position: relative; }
    
    /* 操作パネル：膜（z-index:100）より上に配置 */
    .lock-header {
        padding: 10px; border-bottom: 1px solid #555;
        position: relative; z-index: 110; 
    }

    /* ロック用膜：menu-containerだけを覆う */
    #area-c-lock-overlay {
        display: none; position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        z-index: 100; background: rgba(0,0,0,0.3);
    }
    #area-c-lock-overlay.active { display: block; }

    /* メニュー項目（PHP側からは記号を消している前提） */
    .menu-item {
        display: block; width: 100%; padding: 12px 15px; border: none;
        background-color: #34495e; color: #fff; cursor: pointer; text-align: left;
    }
    .menu-item::before { content: "○"; margin-right: 10px; }
    .menu-item.active { background-color: #f39c12 !important; font-weight: bold; }

    .function-item {
        display: block; width: 100%; padding: 10px 40px; border: none;
        background: transparent; color: #bdc3c7; cursor: pointer; text-align: left;
    }
</style>

<div id="area-c-content">
    <!-- ここは JS で上書きしない -->
    <div class="area-c-static-header">
        <label><input type="checkbox" id="project-lock-check"> ProjectLock</label>
    </div>

    <!-- ここだけを JS (innerHTML) で書き換える -->
    <div id="area-c-replaceable-container">
        {$Area_C_Html}
    </div>
</div>
