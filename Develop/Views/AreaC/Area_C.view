<style>
    /* リスト画面が表示されたら、エリアDを元の30%（または通常サイズ）に戻す */
    [id^="area-d"], [id^="area_d"] {
        width: 30% !important; 
        flex: 0 0 30% !important;
    }
    [id^="area-e"], [id^="area_e"] {
        display: block !important; /* エリアEを復活させる */
    }
</style>
<style>
    /* エリアC全体：縦並びのレイアウトを強制 */
    #area-c-content { 
        height: 100%; 
        display: flex; 
        flex-direction: column; 
        background-color: #2c3e50; 
        position: relative; 
        overflow: hidden; 
    }
    
    /* ロック用膜 */
    #area-c-lock-overlay {
        display: none; position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        z-index: 100; background: rgba(0,0,0,0.4);
    }
    #area-c-lock-overlay.active { display: block; }

    /* メニュー項目：::before を削除して 〇 を抹殺 */
    .menu-item {
        display: block; width: 100%; padding: 12px 15px; border-bottom: 1px solid #34495e;
        background-color: transparent; color: #fff; cursor: pointer; text-align: left;
        box-sizing: border-box;
        text-decoration: none;
    }
    
    .menu-item:hover { background-color: #3e4f5f; }
    .menu-item.active { background-color: #3498db !important; font-weight: bold; }

    /* コンテナ全体も Flex 指定 */
    #area-c-replaceable-container {
        display: flex;
        flex-direction: column;
        height: 100%;
    }
    
    .add-project-btn {
	    font-weight: bold;
	    color: #fff !important;
	    transition: background 0.2s;
	}
	
	.add-project-btn:hover {
	    background-color: #219150 !important; /* 少し明るい緑に */
	}
	
	.navi-list-scroll-area {
	    flex: 1;
	    overflow-y: auto;
	    padding-top: 5px;
	}

	/* ボタンのコンテナ余白 */
    .project-list-container {
        padding: 10px 0;
    }

    /* 新規登録ボタンを「ボタンらしく」する設定 */
    .add-project-btn {
        width: 85%;            /* 横幅を少し絞る */
        margin: 5px auto 15px; /* 中央寄せ & 下に隙間 */
        background-color: #1a7a42 !important; /* 深い緑 */
        border-radius: 6px;    /* 角丸 */
        display: flex;
        justify-content: center; /* 文字を中央へ */
        align-items: center;
        height: 42px;
        border: none !important;
        box-shadow: 0 3px 6px rgba(0,0,0,0.2); /* 影をつけて立体感を出す */
        font-weight: bold;
        cursor: pointer;
    }

    /* アイコンの調整 */
    .add-icon {
        margin-right: 10px;
        font-size: 20px;
        line-height: 1;
    }

    /* ホバー（マウスを乗せた時）の演出 */
    .add-project-btn:hover {
        background-color: #219150 !important;
        transform: translateY(-1px); /* 少し浮く */
    }

    /* クリックした時の演出 */
    .add-project-btn:active {
        transform: translateY(1px); /* 少し沈む */
        box-shadow: none;
    }
    
</style>

<div id="area-c-content">
    <!-- 一旦消してみる -->
	<!-- <div id="area-c-lock-overlay"></div> -->

    <div id="area-c-replaceable-container">
        {$Area_C_Html}
    </div>
</div>
