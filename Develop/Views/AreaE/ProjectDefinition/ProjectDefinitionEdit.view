<style>
    /* エリアE専用のフォームコンテナ調整 */
    .edit-form-container { padding: 30px; max-width: 100%; margin: 0 auto; background-color: #ffffff; }
    
    /* 左右2列のレイアウト（エリアDと並んでも見やすいように調整） */
    .edit-form-columns { display: flex; gap: 40px; }
    .edit-form-column-left, .edit-form-column-right { flex: 1; min-width: 0; }
    
    .edit-field { margin-bottom: 20px; }
    .edit-field label { display: block; margin-bottom: 6px; font-weight: bold; font-size: 0.9em; color: #333; }
    .edit-field input, .edit-field textarea { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; }
    
    /* 主キー（プロジェクトID）は編集不可にするためのスタイル */
    .edit-field input[readonly] { background-color: #f5f5f5; color: #777; cursor: not-allowed; }
    
    .edit-field textarea { resize: vertical; }
    
    /* ボタンエリア */
    .edit-form-actions { margin-top: 30px; text-align: right; border-top: 1px solid #eee; padding-top: 20px; }
    .edit-btn { padding: 10px 22px; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; font-size: 0.95em; }
    .edit-btn-cancel { background-color: #95a5a6; color: white; margin-right: 15px; }
    .edit-btn-save { background-color: #2980b9; color: white; } /* 修正は青系の色を採用 */
</style>

<div class="edit-form-container">
    <h3>プロジェクト定義の修正</h3>
    
    <div class="edit-form-columns">
        <div class="edit-form-column-left">
            <div class="edit-field">
                <label>プロジェクトID（変更不可）</label>
                <input type="text" id="edit_p_id" value="<?= htmlspecialchars($project['project_id'] ?? '', ENT_QUOTES, 'UTF-8') ?>" readonly>
            </div>
            
            <div class="edit-field">
                <label>プロジェクト名</label>
                <input type="text" id="edit_p_name" value="<?= htmlspecialchars($project['project_name'] ?? '', ENT_QUOTES, 'UTF-8') ?>">
            </div>
        </div>
        
        <div class="edit-form-column-right">
            <div class="edit-field">
                <label>DSN (接続文字列)</label>
                <input type="text" id="edit_p_dsn" value="<?= htmlspecialchars($project['dsn'] ?? '', ENT_QUOTES, 'UTF-8') ?>">
            </div>
            
            <div class="edit-field">
                <label>データベースユーザー名</label>
                <input type="text" id="edit_p_username" value="<?= htmlspecialchars($project['username'] ?? '', ENT_QUOTES, 'UTF-8') ?>">
            </div>
            
            <div class="edit-field">
                <label>データベースパスワード</label>
                <input type="password" id="edit_p_password" value="<?= htmlspecialchars($project['password'] ?? '', ENT_QUOTES, 'UTF-8') ?>">
            </div>
            
            <div class="edit-field">
                <label>接続オプション (JSONなど)</label>
                <textarea id="edit_p_options" rows="3"><?= htmlspecialchars($project['options'] ?? '', ENT_QUOTES, 'UTF-8') ?></textarea>
            </div>
        </div>
    </div>

<div class="edit-form-actions">
        <button type="button" class="edit-btn edit-btn-cancel" 
            onclick="
                console.log('キャンセルボタンがクリックされました');
                if(confirm('変更内容は破棄されます。よろしいですか？')){ 
                    console.log('キャンセル確認: OKが押されました。bridgeを呼び出します');
                    parent.bridge({code:'ProjectDefinition/cancelEdit'}); 
                }
            ">
            キャンセル
        </button>

        <button type="button" class="edit-btn edit-btn-save" 
            onclick="
                console.log('修正ボタンがクリックされました');
                var id = document.getElementById('edit_p_id').value;
                var name = document.getElementById('edit_p_name').value;
                var dsn = document.getElementById('edit_p_dsn').value;
                var username = document.getElementById('edit_p_username').value;
                var password = document.getElementById('edit_p_password').value;
                var options = document.getElementById('edit_p_options').value;

                if(!name){ alert('プロジェクト名を入力してください'); return; }
                if(!options){ alert('接続オプションを入力してください'); return; }

                if(confirm('この内容でプロジェクト定義を修正してもよろしいですか？')){
                    console.log('修正確認: OKが押されました。bridgeを呼び出します', id);
                    parent.bridge({
                        code: 'ProjectDefinition/updateProject',
                        p_id: id,
                        p_name: name,
                        p_dsn: dsn,
                        p_username: username,
                        p_password: password,
                        p_options: options
                    });
                }
            ">
            修正
        </button>
    </div>
</div>
