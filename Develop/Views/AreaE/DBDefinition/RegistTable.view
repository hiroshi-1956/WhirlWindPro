        <div id="normal-table-container" style="display: <?php echo ($tType === 'table') ? 'block' : 'none'; ?>;">
            <table class="column-def-table">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>physical</th>
                        <th>logical</th>
