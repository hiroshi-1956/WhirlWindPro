            <div class="import-btn-wrap" id="import-btn-container" style="display: <?php echo ($tType === 'view') ? 'none' : 'block'; ?>;">
                <button type="button" class="btn-top-cancel" onclick="var form = document.getElementById('db-definition-form'); var params = new URLSearchParams(new FormData(form)).toString(); parent.bridge({ code: 'DBDefinition/importTable', data: params });">読み込み</button>
