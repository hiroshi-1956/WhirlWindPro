        <div class="edit-footer">
            <div class="row-ctrl-wrap" id="row-ctrl-container" style="display: <?php echo ($tType === 'table') ? 'flex' : 'none'; ?>;">
                <input type="number" id="target-row-count" min="1" max="30" style="width: 60px; padding: 4px; text-align: center; border: 1px solid #aaa;" value="1">
                <span>行</span>
                <button type="button" style="background-color: #2980b9; color: white; border: none; padding: 5px 15px; border-radius: 3px; font-weight: bold; cursor: pointer;" onclick="executeRowAction('add');">【追加】</button>
                <button type="button" style="background-color: #e67e22; color: white; border: none; padding: 5px 15px; border-radius: 3px; font-weight: bold; cursor: pointer;" onclick="executeRowAction('delete');">【削除】</button>
            </div>        

            <div class="action-btn-wrap">
                <button type="button" class="btn-cancel" onclick="if(confirm('入力内容は破棄されます。登録をキャンセルしますか？')){ parent.bridge({ code: 'DBDefinition/cancel' }); }">キャンセル</button>
                <button type="button" class="btn-register" onclick="prepareAndSubmitForm();">
                    <?php echo $isEditMode ? '保存' : '登録'; ?>
                </button>
            </div>
        </div>

        <div id="sql-preview-container" style="margin-top: 20px; text-align: left; display: <?php echo ($tType === 'view') ? 'block' : 'none'; ?>;">
            <label style="font-weight: bold; font-size: 14px;">生成されるSQLプレビュー</label>
            <textarea id="sql-preview" class="sql-preview-box" readonly placeholder="結合カラムを選択すると、ここにSQLが自動生成されます..."></textarea>
        </div>
    </form>
</div>

<script>
var savedViewMeta = <?php echo $vMeta ? json_encode($vMeta) : 'null'; ?>;
window.allTablesColumnMap = <?php echo json_encode($tablesMap); ?>;

document.addEventListener('DOMContentLoaded', function() {
    function initTableSelectDropdowns() {
        var tables = Object.keys(window.allTablesColumnMap);
        document.querySelectorAll('.select-table-target').forEach(function(selectEl) {
            selectEl.innerHTML = '<option value="">-- テーブルを選択 --</option>';
            tables.forEach(function(tName) {
                var opt = document.createElement('option');
                opt.value = tName;
                opt.textContent = tName;
                selectEl.appendChild(opt);
            });
        });
    }

    initTableSelectDropdowns();

    if (savedViewMeta) {
        if (savedViewMeta.view_table_a) {
            document.getElementById('view_table_a').value = savedViewMeta.view_table_a;
            fetchTableColumns('A');
        }
        if (savedViewMeta.view_table_b) {
            document.getElementById('view_table_b').value = savedViewMeta.view_table_b;
            fetchTableColumns('B');
        }
    }

    document.querySelectorAll('input[name="table_type"]').forEach(function(radio) {
        radio.addEventListener('change', function() {
            var viewRows = document.querySelectorAll('.view-only-rows');
            var normalContainer = document.getElementById('normal-table-container');
            var importBtnContainer = document.getElementById('import-btn-container');
            var rowCtrlContainer = document.getElementById('row-ctrl-container');
            var sqlPreviewContainer = document.getElementById('sql-preview-container');
            
            if (this.value === 'view') {
                viewRows.forEach(row => row.style.display = 'table-row');
                normalContainer.style.display = 'none';
                importBtnContainer.style.display = 'none';
                rowCtrlContainer.style.display = 'none';
                sqlPreviewContainer.style.display = 'block';
                generateViewSQL();
            } else {
                viewRows.forEach(row => row.style.display = 'none');
                normalContainer.style.display = 'block';
                importBtnContainer.style.display = 'block';
                rowCtrlContainer.style.display = 'flex';
                sqlPreviewContainer.style.display = 'none';
                document.getElementById('sql-preview').value = '';
            }
        });
    });

    var tableNameInput = document.querySelector('input[name="table_name"]');
    if (tableNameInput) tableNameInput.addEventListener('input', generateViewSQL);
});

function fetchTableColumns(tableLetter) {
    var selectEl = (tableLetter === 'A') ? document.getElementById('view_table_a') : document.getElementById('view_table_b');
    var targetTable = selectEl.value;
    
    var tbodyCondition = document.querySelector(tableLetter === 'A' ? '#table-a-grid tbody' : '#table-b-grid tbody');
    var tbodyFields = document.querySelector(tableLetter === 'A' ? '#table-a-fields-grid tbody' : '#table-b-fields-grid tbody');

    if (!targetTable) {
        tbodyCondition.innerHTML = '<tr><td colspan="3" class="empty-row-msg">テーブルを選択してください</td></tr>';
        tbodyFields.innerHTML = '<tr><td colspan="3" class="empty-row-msg">テーブルを選択してください</td></tr>';
        generateViewSQL();
        return;
    }

    var columns = window.allTablesColumnMap[targetTable] || [];
    
    // 1. 結合テーブル（条件指定用リスト）を描画
    renderConditionGrid(tableLetter, columns);
    // 2. 結合カラム（出力指定用リスト）を描画
    renderFieldsGrid(tableLetter, columns);

    generateViewSQL();
}

function renderConditionGrid(tableLetter, columns) {
    var tbody = document.querySelector(tableLetter === 'A' ? '#table-a-grid tbody' : '#table-b-grid tbody');
    tbody.innerHTML = '';
    if (columns.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" class="empty-row-msg">カラムが存在しません</td></tr>';
        return;
    }
    var savedKeys = {};
    if (savedViewMeta && savedViewMeta['keys_' + tableLetter.toLowerCase()]) {
        try { savedKeys = JSON.parse(savedViewMeta['keys_' + tableLetter.toLowerCase()]); } catch(e){}
    }
    
    columns.forEach(function(colObj) {
        var colName = colObj.physical;
        var logName = colObj.logical;
        var dataType = colObj.type; // 💡 既存の型を使用
        
        var initialNum = savedKeys[colName] || '';
        var tr = document.createElement('tr');
        tr.innerHTML = '<td><input type="text" class="grid-input-num join-key" data-table="' + tableLetter + '" data-colname="' + escapeHtml(colName) + '" value="' + initialNum + '" oninput="syncAndGenerateSQL()"></td>' +
                       '<td><input type="text" class="input-col col-name" value="' + escapeHtml(colName) + '" readonly style="border:none; background:transparent; text-align:left; padding-left:5px;"></td>' +
                       '<td><input type="text" class="input-col" value="' + escapeHtml(logName) + '" readonly style="border:none; background:transparent; text-align:left; padding-left:5px; color:#555;"></td>' + // 💡 日本語名を追加
                       '<td style="font-size:12px; color:#666; font-family:monospace;">' + escapeHtml(dataType) + '</td>'; // 💡 既存の型を表示
        tbody.appendChild(tr);
    });
}

function renderFieldsGrid(tableLetter, columns) {
    var tbody = document.querySelector(tableLetter === 'A' ? '#table-a-fields-grid tbody' : '#table-b-fields-grid tbody');
    tbody.innerHTML = '';
    document.getElementById('all-check-' + tableLetter.toLowerCase()).checked = true;

    if (columns.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" class="empty-row-msg">カラムが存在しません</td></tr>';
        return;
    }

    var savedSelectFields = null;
    if (savedViewMeta && savedViewMeta.select_cols) {
        try { savedSelectFields = JSON.parse(savedViewMeta.select_cols); } catch(e){}
    }

    columns.forEach(function(colObj) {
        var colName = colObj.physical;
        var logName = colObj.logical;
        var dataType = colObj.type; // 💡 既存の型を使用

        var isChecked = true;
        if (savedSelectFields && savedSelectFields[tableLetter]) {
            isChecked = savedSelectFields[tableLetter].includes(colName);
        }

        var tr = document.createElement('tr');
        tr.innerHTML = '<td><input type="checkbox" class="select-field-checkbox" data-table="' + tableLetter + '" data-colname="' + escapeHtml(colName) + '" ' + (isChecked ? 'checked' : '') + ' onchange="syncAndGenerateSQL()"></td>' +
                       '<td><input type="text" class="input-col" value="' + escapeHtml(colName) + '" readonly style="border:none; background:transparent; text-align:left; padding-left:5px;"></td>' +
                       '<td><input type="text" class="input-col" value="' + escapeHtml(logName) + '" readonly style="border:none; background:transparent; text-align:left; padding-left:5px; color:#555;"></td>' + // 💡 日本語名を追加
                       '<td style="font-size:12px; color:#666; font-family:monospace;">' + escapeHtml(dataType) + '</td>'; // 💡 既存の型を表示
        tbody.appendChild(tr);
    });
}

function toggleAllSelectFields(tableLetter, master) {
    document.querySelectorAll('.select-field-checkbox[data-table="' + tableLetter + '"]').forEach(function(cb) {
        cb.checked = master.checked;
    });
    syncAndGenerateSQL();
}

function syncAndGenerateSQL() {
    var metaA = {}, metaB = {};
    document.querySelectorAll('.join-key').forEach(function(input) {
        var num = input.value.trim();
        var tableLetter = input.dataset.table;
        var cName = input.dataset.colname;
        if (num !== '' && cName) {
            if (tableLetter === 'A') metaA[cName] = num;
            if (tableLetter === 'B') metaB[cName] = num;
        }
    });
    document.getElementById('view_keys_a_meta').value = JSON.stringify(metaA);
    document.getElementById('view_keys_b_meta').value = JSON.stringify(metaB);

    var selectColsMeta = { 'A': [], 'B': [] };
    document.querySelectorAll('.select-field-checkbox:checked').forEach(function(cb) {
        selectColsMeta[cb.dataset.table].push(cb.dataset.colname);
    });
    document.getElementById('view_select_cols_meta').value = JSON.stringify(selectColsMeta);

    generateViewSQL();
}

function generateViewSQL() {
    var tableTypeActive = document.querySelector('input[name="table_type"]:checked');
    if (!tableTypeActive || tableTypeActive.value !== 'view') return;

    var tableName = document.querySelector('input[name="table_name"]').value.trim() || 'VIEW_NAME';
    var joinType = document.querySelector('input[name="join_type"]:checked')?.value || 'INNER JOIN';
    
    var tableA = document.getElementById('view_table_a').value || 'table_A';
    var tableB = document.getElementById('view_table_b').value || 'table_B';

    var keysA = {}, keysB = {};
    document.querySelectorAll('.join-key').forEach(function(input) {
        var num = input.value.trim();
        if (num !== '') {
            var cName = input.dataset.colname;
            var tName = (input.dataset.table === 'A') ? tableA : tableB;
            if (input.dataset.table === 'A') keysA[num] = tName + '.' + cName;
            if (input.dataset.table === 'B') keysB[num] = tName + '.' + cName;
        }
    });

    var joinOnClauses = [];
    for (var k in keysA) {
        if (keysB[k]) joinOnClauses.push(keysA[k] + ' = ' + keysB[k]);
    }
    var onSentence = joinOnClauses.length > 0 ? joinOnClauses.join(' AND ') : tableA + '.id = ' + tableB + '.id';

    // 💡 選択されたチェックボックスからのみSELECT句を生成
    var allSelectCols = [];
    document.querySelectorAll('.select-field-checkbox:checked').forEach(function(cb) {
        var tName = (cb.dataset.table === 'A') ? tableA : tableB;
        allSelectCols.push('    ' + tName + '.' + cb.dataset.colname);
    });

    if (allSelectCols.length === 0) {
        allSelectCols.push('    *');
    }

    var sql = 'CREATE OR REPLACE VIEW ' + tableName + ' AS\n' +
              'SELECT\n' + allSelectCols.join(',\n') + '\n' +
              'FROM ' + tableA + '\n' +
              joinType + ' ' + tableB + ' ON ' + onSentence + ';';

    var previewArea = document.getElementById('sql-preview');
    if (previewArea) previewArea.value = sql;
}

function prepareAndSubmitForm() {
    var tableType = document.querySelector('input[name="table_type"]:checked').value;
    var logicalName = document.querySelector('input[name="logical_name"]').value.trim();
    
    if (tableType === 'view') {
        if (!logicalName) { alert('日本語名称を入力してください。'); return; }
        if (!confirm('入力した内容でビューを登録してもよろしいですか？')) return;
        
        var normalTbody = document.querySelector('.column-def-table tbody');
        normalTbody.innerHTML = ''; 
        
        var idx = 0;
        // 💡 選択された結合カラム（チェックボックス）をループ処理
        document.querySelectorAll('.select-field-checkbox:checked').forEach(function(cb) {
            var colName = cb.dataset.colname;       // カラム名（例: id）
            var tableLetter = cb.dataset.table;     // 'A' または 'B'
            
            // 💡 選択されている実際のテーブル名（例: applicantmaster など）を取得
            var tableName = (tableLetter === 'A') 
                ? document.getElementById('view_table_a').value 
                : document.getElementById('view_table_b').value;
            
            // 💡 重複を避けるため「テーブル名_カラム名」という物理名にする
            var uniquePhysicalName = tableName + '_' + colName; 
            // 💡 論理名（日本語名）も分かりやすいように「ビュー名 (カラム名)」の形にする
            var uniqueLogicalName = logicalName + ' (' + colName + ')';

            // システム（PHP）が受け取れる形にhiddenタグを生成して詰め込む
            normalTbody.innerHTML += '<input type="hidden" name="col_physical[' + idx + ']" value="' + uniquePhysicalName + '">' +
                                     '<input type="hidden" name="col_logical[' + idx + ']" value="' + uniqueLogicalName + '">' +
                                     '<input type="hidden" name="col_type[' + idx + ']" value="varchar">';
            idx++;
        });
    } else {
        if (!confirm('入力した内容でテーブルを登録してもよろしいですか？')) return;
    }

    var form = document.getElementById('db-definition-form');
    var params = new URLSearchParams(new FormData(form)).toString();
    parent.bridge({ code: 'DBDefinition/register', data: params });
}

function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}


</script>
