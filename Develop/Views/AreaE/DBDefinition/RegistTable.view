                        <td><input type="hidden" name="col_null[<?php echo $i; ?>]" value="0"><input type="checkbox" name="col_null[<?php echo $i; ?>]" value="1" <?php echo (!empty($row['null']) && $row['null'] !== '0') ? 'checked="checked"' : ''; ?>></td>
                        <td><input type="hidden" name="col_unique[<?php echo $i; ?>]" value="0"><input type="checkbox" name="col_unique[<?php echo $i; ?>]" value="1" <?php echo (!empty($row['unique']) && $row['unique'] !== '0') ? 'checked="checked"' : ''; ?>></td>
                        <td><input type="text" class="input-col" name="col_default[<?php echo $i; ?>]" value="<?php echo htmlspecialchars($row['default'] ?? '', ENT_QUOTES); ?>"></td>
