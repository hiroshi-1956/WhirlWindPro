    <!-- 各種モジュールコンテナ（PHPのswitchで動的に切り替え） -->
    <div id="module-container" style="margin-top: 0;">
        <?php
        switch ($parts_type) {
            case 'Single Record Input':
                @include __DIR__ . '/parts/single_record_input.view';
                echo '<script>console.log("[PHP Debug] Loaded Module: Single Record Input");</script>';
                break;
                
            case 'Multi Record Input':
                @include __DIR__ . '/parts/multi_record_input.view';
                echo '<script>console.log("[PHP Debug] Loaded Module: Multi Record Input");</script>';
                break;

            default:
                echo '<div style="padding: 20px; color: #666; border: 1px dashed #ccc; width: 780px; margin-top: 10px;">種類を選択すると、対応する専用モジュールが起動します。</div>';
                break;
        }
        ?>
    </div>

    <!-- 共通アクションボタン -->
    <div style="width: 900px; display: flex; justify-content: flex-end; gap: 15px; margin-top: 30px; padding-bottom: 20px;">
        <button type="button" onclick="onClickCancel();" style="width: 120px; height: 36px; background-color: #c9302c; border: none; color: #fff; font-size: 14px; font-weight: bold; border-radius: 4px; cursor: pointer; outline: none;">キャンセル</button>
        <button type="button" onclick="onClickSave();" style="width: 120px; height: 36px; background-color: #218838; border: none; color: #fff; font-size: 14px; font-weight: bold; border-radius: 4px; cursor: pointer; outline: none;">保存</button>
    </div>
</div>

<script>
if (typeof window.bridge !== 'function') {
    window.bridge = (typeof parent !== 'undefined' && typeof parent.bridge === 'function') 
        ? parent.bridge 
        : function(payload) { console.log('Bridge payload:', payload); };
}

// 種類の変更に応じて、対応するモジュールペインをJavaScriptで即座に切り替える
function onChangePartsType(selectedType) {
    console.log('[JS Debug] onChangePartsType switched to:', selectedType);

    const panes = document.querySelectorAll('.parts-module-pane');
    panes.forEach(pane => pane.style.display = 'none');

    if (selectedType === 'Single Record Input') {
        const target = document.getElementById('module-single-record-input');
        if (target) target.style.display = 'block';
    } else if (selectedType === 'Multi Record Input') {
        const target = document.getElementById('module-multi-record-input');
        if (target) target.style.display = 'block';
    } else if (selectedType === 'Text Input') {
        const target = document.getElementById('module-text-input');
        if (target) target.style.display = 'block';
    } else {
        const target = document.getElementById('module-empty');
        if (target) target.style.display = 'block';
    }

    if (typeof window.bridge === 'function') {
        window.bridge({
            code: 'PartsDefinition/changeType',
            parts_id: document.getElementById('parts_id').value,
            parts_name: document.getElementById('parts_name').value,
            parts_description: document.getElementById('parts_description').value,
            parts_type: selectedType
        });
    }
}

function onClickCancel() {
    if (confirm('戻りますか？')) {
        if (typeof window.bridge === 'function') window.bridge({ code: 'PartsDefinition/cancel' });
        else history.back();
    }
}

function onClickSave() {
    if (!document.getElementById('parts_name').value.trim()) {
        alert('画面パーツ名称を入力してください。');
        return;
    }
    if (!confirm('保存しますか？')) return;

    // 1. 最新の選択状態を隠しフィールドに同期
    if (typeof updateSerializedData === 'function') {
        updateSerializedData();
    }

    const getRadioValue = (name) => {
        const checkedEl = document.querySelector(`input[name="${name}"]:checked`);
        return checkedEl ? checkedEl.value : '';
    };

    // 2. 送信データ (payload) の作成
    const payload = {
        code: 'PartsDefinition/save',
        parts_id: document.getElementById('parts_id').value,
        parts_name: document.getElementById('parts_name').value.trim(),
        parts_description: document.getElementById('parts_description').value,
        parts_type: document.getElementById('parts_type').value,
        
        table_name: document.getElementById('table_name') ? document.getElementById('table_name').value : '',
        preview_title: document.getElementById('preview_title') ? document.getElementById('preview_title').value : '',
        input_rows: document.getElementById('input_rows') ? document.getElementById('input_rows').value : '',
        display_label: getRadioValue('display_label'),
        column_filter: getRadioValue('column_filter'),

        // ★ ここがDBのカラム名と紐づきます
        checked_columns_json: document.getElementById('checked_columns_json') ? document.getElementById('checked_columns_json').value : '[]',
        input_style: document.getElementById('input_style_hidden') ? document.getElementById('input_style_hidden').value : '[]'
    };

    console.log('[JS Debug] Final Save Payload:', payload);

    window.bridge(payload);
}
</script>