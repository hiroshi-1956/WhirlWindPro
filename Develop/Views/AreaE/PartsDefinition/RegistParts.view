                style="width: 120px; height: 36px; background-color: #218838; border: none; color: #fff; font-size: 14px; font-weight: bold; border-radius: 4px; cursor: pointer; outline: none; box-sizing: border-box; transition: opacity 0.1s;"
                onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1.0'">
