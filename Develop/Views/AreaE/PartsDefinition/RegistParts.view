<script>
if (typeof bridge === 'undefined' && typeof parent !== 'undefined' && typeof parent.bridge === 'function') {
    var bridge = parent.bridge;
}

const STORAGE_KEY_MAIN_FORM = 'wwProject_main_form_backup';
var currentTableColumns = []; 

<?php if (!empty($m_partsinfo_columns)): ?>
    currentTableColumns = <?= json_encode($m_partsinfo_columns, JSON_UNESCAPED_UNICODE) ?>;
<?php endif; ?>

function getInputStyleValue() {
    var typeSel = document.getElementById('parts_type');
    var targetType = typeSel ? typeSel.value : '';
    
    // Single Record Input の時だけプルダウンの値を集める
    if (targetType === 'Single Record Input') {
        var styles = [];
        document.querySelectorAll('.single-input-style-select').forEach(function(sel) {
            styles.push(sel.value || '');
        });
        return styles.join(',');
    }
    
    // Single Record Confirm の時はスタイルは不要なので空文字を返す
    if (targetType === 'Single Record Confirm') {
        return '';
    }
    
    // 💡 Confirm時（非表示状態）でも正しく値を集められるように修正
    if (targetType === 'Multi Record Input' || targetType === 'Multi Record Confirm') {
        var multiStyles = [];
        document.querySelectorAll('.multi-input-style-select').forEach(function(sel) {
            multiStyles.push(sel.value || '');
        });
        return multiStyles.join(','); 
    }

    if (targetType === 'Text Input' || targetType === 'Text Confirm') {
        var textStyles = [];
        document.querySelectorAll('.textinput-type-select').forEach(function(sel) {
            textStyles.push(sel.value || '');
        });
        return textStyles.join(',');
    }

    return '';
}

function onClickCancel() {
    if (confirm('入力内容を破棄して戻りますか？')) {
        clearMainFormBackup();
        if (typeof bridge === 'function') {
            bridge({ code: 'PartsDefinition/cancel' });
        } else {
            window.history.back();
        }
    }
}

function getSelectedColumnsArray() {
    var typeSel = document.getElementById('parts_type');
    var targetType = typeSel ? typeSel.value : '';
    
    if (targetType === 'Text Input' || targetType === 'Text Confirm') {
        var arrText = [];
        document.querySelectorAll('.textinput-type-select').forEach(function(sel) {
            arrText.push(sel.value);
        });
        return arrText;
    }

    var arr = [];
    var selector = 'input[name="selected_columns_vertical[]"]:checked, input[name="selected_columns_horizontal[]"]:checked';
    document.querySelectorAll(selector).forEach(function(cb) {
        if (!arr.includes(cb.value)) {
            arr.push(cb.value);
        }
    });

    if (arr.length === 0) {
        var sessionData = sessionStorage.getItem(STORAGE_KEY_MAIN_FORM);
        if (sessionData) {
            try {
                var formData = JSON.parse(sessionData);
                if (formData.selected_columns && Array.isArray(formData.selected_columns) && formData.selected_columns.length > 0) {
                    return formData.selected_columns;
                }
            } catch(e) {}
        }
        
        document.querySelectorAll('input[name="selected_columns_vertical[]"]:checked').forEach(function(cb) {
            if (!arr.includes(cb.value)) arr.push(cb.value);
        });
    }

    return arr;
}

function getTextInputConfigsArray() {
    var arr = [];
    document.querySelectorAll('.textinput-data-row').forEach(function(row) {
        var label = row.querySelector('.textinput-label-input')?.value || '';
        var type = row.querySelector('.textinput-type-select')?.value || 'text';
        arr.push({ label: label, type: type });
    });
    return arr;
}

function onClickSave() {
    var partsName = document.getElementById('parts_name')?.value.trim();
    if (!partsName) {
        alert('画面パーツ名称を入力してください。');
        return;
    }
    
    if (!confirm('この内容で画面パーツ情報を保存しますか？')) {
        return;
    }
    
    try {
        var partsType = document.getElementById('parts_type')?.value;
        var dispEle = document.querySelector('input[name="display_label"]:checked');
        var displayLabel = dispEle ? dispEle.value : 'physical';
        var filtEle = document.querySelector('input[name="column_filter"]:checked');
        var columnFilter = filtEle ? filtEle.value : 'all';
        
        // 💡 修正ポイント: 空文字（''）を絶対に送らず、デフォルトの「1」をセットします
        var inputRows = '1'; 
        if (partsType === 'Multi Record Input' || partsType === 'Multi Record Confirm' || partsType === 'Text Input' || partsType === 'Text Confirm') {
            inputRows = document.getElementById('input_rows')?.value || '1';
        }

        var finalSelectedColumns = [];
        try {
            finalSelectedColumns = getSelectedColumnsArray();
        } catch(e) {
            console.error("getSelectedColumnsArrayでエラーが発生:", e);
        }

        var finalInputStyle = '';
        try {
            finalInputStyle = getInputStyleValue();
        } catch(e) {
            console.error("getInputStyleValueでエラーが発生:", e);
        }

        if (partsType === 'Text Input' || partsType === 'Text Confirm') {
            finalInputStyle = finalSelectedColumns.join(','); 
            finalSelectedColumns = []; 
        }

        var finalTextinputConfigs = [];
        try {
            finalTextinputConfigs = getTextInputConfigsArray();
        } catch(e) {
            console.error("getTextInputConfigsArrayでエラーが発生:", e);
        }

        var saveData = {
            code: 'PartsDefinition/save',
            parts_id: document.getElementById('parts_id')?.value || '',
            parts_name: partsName,
            parts_description: document.getElementById('parts_description')?.value || '',
            parts_type: partsType,
            table_name: document.getElementById('table_name')?.value || '',
            display_label: displayLabel,
            column_filter: columnFilter,
            input_rows: inputRows, // 💡 ここに必ず「1」以上の文字列（数値）が入るようになります
            input_style: finalInputStyle,       
            preview_title: document.getElementById('preview_title')?.value || '',
            selected_columns: finalSelectedColumns, 
            textinput_configs: finalTextinputConfigs
        };

        if (typeof bridge === 'function') {
            bridge(saveData);
        } else {
            alert('保存処理を実行します（bridgeが定義されていません）。');
            console.log("送信データ:", saveData);
        }

    } catch (globalError) {
        alert('JavaScriptの処理中にエラーが発生したため保存が中断されました。\nエラー内容: ' + globalError.message);
        console.error(globalError);
    }
}

function loadColumnsFromDB() {
    var tableSelect = document.getElementById('table_name');
    if (!tableSelect) return;

    var selectedTableName = tableSelect.value;
    var partsId      = document.getElementById('parts_id')?.value || '';
    var partsName    = document.getElementById('parts_name')?.value || '';
    var partsDesc    = document.getElementById('parts_description')?.value || '';
    var partsType    = document.getElementById('parts_type')?.value || '';
    var previewTitle = document.getElementById('preview_title')?.value || '';
    var inputRows    = (partsType === 'Multi Record Input' || partsType === 'Multi Record Confirm' || partsType === 'Text Input' || partsType === 'Text Confirm') ? (document.getElementById('input_rows')?.value || '1') : '';
    var inputStyle   = getInputStyleValue(); 

    var dispEle = document.querySelector('input[name="display_label"]:checked');
    var displayLabel = dispEle ? dispEle.value : 'physical';
    var filtEle = document.querySelector('input[name="column_filter"]:checked');
    var columnFilter = filtEle ? filtEle.value : 'all';

    if (typeof bridge === 'function') {
        bridge({
            code: 'PartsDefinition/getColumns',
            table_name: selectedTableName,
            parts_id: partsId,
            parts_name: partsName,
            parts_description: partsDesc,
            parts_type: partsType,
            display_label: displayLabel,
            column_filter: columnFilter,
            input_rows: inputRows,
            input_style: inputStyle, 
            preview_title: previewTitle
        });
    }
}

function switchDisplayLabel(mode) {
    document.querySelectorAll('.vertical-label-cell, .middle-label-cell').forEach(function(cell) {
        if (mode === 'logical') {
            cell.textContent = cell.getAttribute('data-logical');
        } else {
            cell.textContent = cell.getAttribute('data-physical');
        }
    });
}

function syncCheckboxes(origin, idx) {
    var vChk = document.querySelector('input[name="selected_columns_vertical[]"][data-index="' + idx + '"]');
    var hChk = document.querySelector('input[name="selected_columns_horizontal[]"][data-index="' + idx + '"]');
    if (origin === 'vertical') {
        if (vChk && hChk) hChk.checked = vChk.checked;
    } else {
        if (vChk && hChk) vChk.checked = hChk.checked;
    }
}

function toggleFieldsByType() {
    var typeSel = document.getElementById('parts_type');
    var container = document.getElementById('single-record-input-fields-container');
    var countRow = document.getElementById('live-column-count-row');
    var countLabel = document.getElementById('column-count-label');
    
    var rowTable = document.getElementById('row-table-id');
    var rowDisplay = document.getElementById('row-display-label');
    var rowFilter = document.getElementById('row-column-filter');

    var layoutVertical = document.getElementById('container-layout-vertical');
    var layoutHorizontal = document.getElementById('container-layout-horizontal');
    var layoutTextInput = document.getElementById('container-layout-textinput');

    if (!typeSel || !container) return;
    var targetType = typeSel.value;

    if (targetType === 'Single Record Input' || targetType === 'Single Record Confirm' || 
        targetType === 'Multi Record Input' || targetType === 'Multi Record Confirm' || 
        targetType === 'Text Input' || targetType === 'Text Confirm' || targetType === 'Test Display') {
        
        container.style.setProperty('display', 'block', 'important');

        if (targetType === 'Text Input' || targetType === 'Text Confirm') {
            if (rowTable) rowTable.style.setProperty('display', 'none', 'important');
            if (rowDisplay) rowDisplay.style.setProperty('display', 'none', 'important');
            if (rowFilter) rowFilter.style.setProperty('display', 'none', 'important');
            
            if (countRow) countRow.style.setProperty('display', 'table-row', 'important');
            if (countLabel) countLabel.textContent = '入力桁数';

            if (layoutVertical) layoutVertical.style.setProperty('display', 'none', 'important');
            if (layoutHorizontal) layoutHorizontal.style.setProperty('display', 'none', 'important');
            if (layoutTextInput) layoutTextInput.style.setProperty('display', 'block', 'important');
            
            syncTextInputRows();
        } else {
            if (rowTable) rowTable.style.setProperty('display', 'table-row', 'important');
            if (rowDisplay) rowDisplay.style.setProperty('display', 'table-row', 'important');
            if (rowFilter) rowFilter.style.setProperty('display', 'table-row', 'important');
            if (countLabel) countLabel.textContent = '入力行数';

            if (targetType === 'Multi Record Input' || targetType === 'Multi Record Confirm') {
                if (countRow) countRow.style.setProperty('display', 'table-row', 'important');
                if (layoutVertical) layoutVertical.style.setProperty('display', 'none', 'important');
                if (layoutHorizontal) layoutHorizontal.style.setProperty('display', 'block', 'important');
                if (layoutTextInput) layoutTextInput.style.setProperty('display', 'none', 'important');
                
                syncDynamicInputRows();
            } else {
                if (countRow) countRow.style.setProperty('display', 'none', 'important');
                if (layoutVertical) layoutVertical.style.setProperty('display', 'block', 'important');
                if (layoutHorizontal) layoutHorizontal.style.setProperty('display', 'none', 'important');
                if (layoutTextInput) layoutTextInput.style.setProperty('display', 'none', 'important');
            }
        }
    } else {
        container.style.setProperty('display', 'none', 'important');
    }

    // Single Record Confirm の個別処理
    document.querySelectorAll('#vertical-columns-table tr').forEach(function(row) {
        var selectEl = row.querySelector('select'); 
        var tds = row.querySelectorAll('td');
        
        if (tds.length >= 3) {
            var styleTd = tds[2];
            styleTd.style.setProperty('display', 'table-cell', 'important'); 
            if (layoutVertical) layoutVertical.style.width = '520px';

            if (selectEl) {
                if (targetType === 'Single Record Confirm') {
                    selectEl.style.setProperty('display', 'none', 'important');
                } else {
                    selectEl.style.setProperty('display', 'block', 'important');
                }
            }
        }
    });
    
    toggleColumnListVisibility();
}

function toggleColumnListVisibility() {
    var wrapper = document.getElementById('column-list-wrapper');
    var tableSelect = document.getElementById('table_name');
    var tableName = tableSelect ? tableSelect.value : '';
    
    var typeSel = document.getElementById('parts_type');
    var targetType = typeSel ? typeSel.value : '';

    if (targetType === 'Text Input' || targetType === 'Text Confirm') {
        if (wrapper) wrapper.style.setProperty('display', 'block', 'important');
        return;
    }

    if (tableName === '') {
        if (wrapper) wrapper.style.setProperty('display', 'none', 'important');
        return;
    }
    if (wrapper) wrapper.style.setProperty('display', 'block', 'important');
    
    var filterEle = document.querySelector('input[name="column_filter"]:checked');
    var filterVal = filterEle ? filterEle.value : 'all';

    if (targetType === 'Multi Record Input' || targetType === 'Multi Record Confirm') {
        var checkedIndexes = [];
        document.querySelectorAll('input[name="selected_columns_horizontal[]"]').forEach(function(chk) {
            if (chk.checked) checkedIndexes.push(chk.getAttribute('data-index'));
        });

        document.querySelectorAll('.column-cell-block').forEach(function(cell) {
            var idx = cell.getAttribute('data-col-index');
            var isChecked = checkedIndexes.includes(idx);
            var innerBox = cell.querySelector('.inner-cell-box');

            if (filterVal === 'selected') {
                if (!isChecked) {
                    cell.style.setProperty('display', 'none', 'important');
                } else {
                    cell.style.setProperty('display', 'table-cell', 'important');
                    if (innerBox) innerBox.style.setProperty('display', 'block', 'important');
                }
            } else {
                cell.style.setProperty('display', 'table-cell', 'important');
                if (innerBox) innerBox.style.setProperty('display', 'block', 'important');
            }
        });
    } else {
        document.querySelectorAll('.vertical-row-item').forEach(function(row) {
            var idx = row.getAttribute('data-index');
            var chk = document.querySelector('input[name="selected_columns_vertical[]"][data-index="' + idx + '"]');
            if (filterVal === 'selected' && (!chk || !chk.checked)) {
                row.style.setProperty('display', 'none', 'important');
            } else {
                row.style.setProperty('display', 'table-row', 'important');
            }
        });
    }
}

function syncDynamicInputRows() {
    var typeSel = document.getElementById('parts_type');
    var targetType = typeSel ? typeSel.value : '';
    var tbody = document.getElementById('target-columns-tbody');
    
    if (!tbody || (targetType !== 'Multi Record Input' && targetType !== 'Multi Record Confirm')) return;

    document.querySelectorAll('.dynamic-data-row').forEach(function(el) { el.remove(); });

    var inputRowsEle = document.getElementById('input_rows');
    var rowCount = parseInt(inputRowsEle ? inputRowsEle.value : '1', 10);
    if (isNaN(rowCount) || rowCount < 1) rowCount = 1;

    var columnCheckboxes = document.querySelectorAll('input[name="selected_columns_horizontal[]"]');
    var totalColumns = columnCheckboxes.length;

    var inputStyleDataArray = [];
    <?php if (!empty($input_style)): ?>
        inputStyleDataArray = <?= json_encode(explode(',', $input_style), JSON_UNESCAPED_UNICODE) ?>;
    <?php endif; ?>

    var opts = ['―― 選択してください ――', 'text', 'pulldown', 'radiobox', 'checkbox', 'button'];

    for (var i = 1; i <= rowCount; i++) {
        var tr = document.createElement('tr');
        tr.className = 'dynamic-data-row';
        tr.style.height = '35px';
        tr.style.borderBottom = '1px solid #ccc';

        var th = document.createElement('th');
        th.style.cssText = 'text-align: center; font-weight: normal; border-right: 2px solid #000; background-color: #f9f9f9; white-space: nowrap; color: #000;';
        th.textContent = i;
        tr.appendChild(th);

        for (var j = 0; j < totalColumns; j++) {
            var td = document.createElement('td');
            td.className = 'column-cell-block dynamic-cell';
            td.setAttribute('data-col-index', j);
            td.style.cssText = 'padding: 5px 15px; border-right: 1px solid #ccc; background-color: #fff; vertical-align: middle;';
            
            if (i === 1) {
                var defaultStyle = inputStyleDataArray[j] || '';

                var select = document.createElement('select');
                select.className = 'multi-input-style-select'; 
                select.style.cssText = 'width: 100%; min-width: 120px; height: 26px; border: 1px solid #000; box-sizing: border-box; outline: none; font-size: 14px; cursor: pointer;';
                select.onchange = function() { saveMainForm(); };

                opts.forEach(function(o) {
                    var optEle = document.createElement('option');
                    optEle.value = (o.indexOf('選択してください') !== -1) ? '' : o;
                    optEle.textContent = o;
                    if (optEle.value === defaultStyle) optEle.selected = true;
                    select.appendChild(optEle);
                });

                // 💡 Multi Record Confirm の場合は、要素自体は残して表示だけ隠す
                if (targetType === 'Multi Record Confirm') {
                    select.style.setProperty('display', 'none', 'important');
                }

                td.appendChild(select);
            } else {
                td.innerHTML = '<div class="inner-cell-box" style="width: 100%; min-width: 80px; height: 24px; border: 1px dashed #ccc; background-color: #fafafa;"></div>';
            }
            
            tr.appendChild(td);
        }
        tbody.appendChild(tr);
    }

    toggleColumnListVisibility();
}

function syncTextInputRows() {
    var typeSel = document.getElementById('parts_type');
    var targetType = typeSel ? typeSel.value : '';
    var tbody = document.getElementById('target-textinput-tbody');
    
    if (!tbody || (targetType !== 'Text Input' && targetType !== 'Text Confirm')) return;

    var savedValues = [];
    tbody.querySelectorAll('.textinput-data-row').forEach(function(row) {
        var idx = row.getAttribute('data-row-index');
        var labelVal = row.querySelector('.textinput-label-input')?.value || '';
        var typeVal = row.querySelector('.textinput-type-select')?.value || 'text';
        savedValues[idx] = { label: labelVal, type: typeVal };
    });

    tbody.innerHTML = '';

    var inputRowsEle = document.getElementById('input_rows');
    var rowCount = parseInt(inputRowsEle ? inputRowsEle.value : '1', 10);
    if (isNaN(rowCount) || rowCount < 1) rowCount = 1;

    var inputStyleDataArray = [];
    <?php if (!empty($input_style)): ?>
        inputStyleDataArray = <?= json_encode(explode(',', $input_style), JSON_UNESCAPED_UNICODE) ?>;
    <?php endif; ?>

    var jsonEle = document.getElementById('textinput_configs_json');
    var initialConfigs = [];
    if (jsonEle && jsonEle.value) {
        try { initialConfigs = JSON.parse(jsonEle.value); } catch(e){}
    }

    for (var i = 1; i <= rowCount; i++) {
        var tr = document.createElement('tr');
        tr.className = 'textinput-data-row';
        tr.setAttribute('data-row-index', i - 1);
        tr.style.height = '40px';
        tr.style.borderBottom = '1px solid #ccc';

        var tdNum = document.createElement('td');
        tdNum.style.cssText = 'width: 50px; text-align: center; border-right: 1px solid #ccc; background-color: #fafafa; font-weight: bold; color: #000;';
        tdNum.textContent = i;
        tr.appendChild(tdNum);

        var tdLabel = document.createElement('td');
        tdLabel.style.cssText = 'padding: 5px 10px; border-right: 1px solid #ccc;';
        
        var defaultLabel = 'カラム' + i;
        if (savedValues[i - 1]) {
            defaultLabel = savedValues[i - 1].label;
        } else if (initialConfigs[i - 1] && initialConfigs[i - 1].label) {
            defaultLabel = initialConfigs[i - 1].label;
        }

        var input = document.createElement('input');
        input.type = 'text';
        input.className = 'textinput-label-input';
        input.style.cssText = 'width: 100%; height: 28px; border: 1px solid #000; padding: 0 6px; box-sizing: border-box; outline: none; font-size: 14px;';
        input.value = defaultLabel;
        input.oninput = function() { saveMainForm(); };
        tdLabel.appendChild(input);
        tr.appendChild(tdLabel);

        var tdType = document.createElement('td');
        tdType.style.cssText = 'padding: 5px 10px; width: 180px;';

        var defaultType = 'text';
        if (savedValues[i - 1]) {
            defaultType = savedValues[i - 1].type;
        } 
        else if (inputStyleDataArray[i - 1]) {
            defaultType = inputStyleDataArray[i - 1]; 
        } else if (initialConfigs[i - 1] && initialConfigs[i - 1].type) {
            defaultType = initialConfigs[i - 1].type;
        }

        var select = document.createElement('select');
        select.className = 'textinput-type-select';
        select.style.cssText = 'width: 100%; height: 28px; border: 1px solid #000; box-sizing: border-box; outline: none; font-size: 14px; cursor: pointer;';
        select.onchange = function() { saveMainForm(); };

        var opts = ['―― 選択してください ――', 'text', 'pulldown', 'radiobox', 'checkbox', 'button'];
        opts.forEach(function(o) {
            var optEle = document.createElement('option');
            optEle.value = o;
            optEle.textContent = o;
            if (o === defaultType) optEle.selected = true;
            select.appendChild(optEle);
        });

        if (targetType === 'Text Confirm') {
            select.style.setProperty('display', 'none', 'important');
        }

        tdType.appendChild(select);
        tr.appendChild(tdType);
        tbody.appendChild(tr);
    }
}

function saveMainForm() {
    var isEditMode = document.getElementById('is_edit_mode_flag').value === '1';
    if (!isEditMode) return; 

    var sessionData = sessionStorage.getItem(STORAGE_KEY_MAIN_FORM);
    var formData = sessionData ? JSON.parse(sessionData) : {};

    formData.parts_id = document.getElementById('parts_id')?.value || '';
    formData.parts_name = document.getElementById('parts_name')?.value || '';
    formData.parts_description = document.getElementById('parts_description')?.value || '';
    formData.parts_type = document.getElementById('parts_type')?.value || '';
    formData.table_name = document.getElementById('table_name')?.value || '';
    formData.input_style = getInputStyleValue(); 
    
    var dispEle = document.querySelector('input[name="display_label"]:checked');
    formData.display_label = dispEle ? dispEle.value : 'physical';
    
    var filtEle = document.querySelector('input[name="column_filter"]:checked');
    formData.column_filter = filtEle ? filtEle.value : 'all';
    
    formData.input_rows = (formData.parts_type === 'Multi Record Input' || formData.parts_type === 'Multi Record Confirm' || formData.parts_type === 'Text Input' || formData.parts_type === 'Text Confirm') ? (document.getElementById('input_rows')?.value || '1') : '';
    formData.preview_title = document.getElementById('preview_title')?.value || '';
    
    var newCols = getSelectedColumnsArray();
    if (newCols.length > 0 || !formData.selected_columns) {
        formData.selected_columns = newCols;
    }
    
    formData.textinput_configs = getTextInputConfigsArray();
    sessionStorage.setItem(STORAGE_KEY_MAIN_FORM, JSON.stringify(formData));
    
    var jsonEle = document.getElementById('textinput_configs_json');
    if (jsonEle) jsonEle.value = JSON.stringify(formData.textinput_configs);
}

function clearMainFormBackup() {
    sessionStorage.removeItem(STORAGE_KEY_MAIN_FORM);
}

document.addEventListener('DOMContentLoaded', function() {
    var isEditMode = document.getElementById('is_edit_mode_flag')?.value === '1';
    
    if (!isEditMode) {
        clearMainFormBackup();
        toggleFieldsByType();
        return;
    }

    var tableSelect = document.getElementById('table_name');
    var verticalTable = document.getElementById('vertical-columns-table');
    var hasRows = verticalTable && verticalTable.querySelectorAll('.vertical-row-item').length > 0;

    if (tableSelect && tableSelect.value !== '' && !hasRows) {
        loadColumnsFromDB();
    }

    var currentPartsId = document.getElementById('parts_id')?.value || '';
    var sessionData = sessionStorage.getItem(STORAGE_KEY_MAIN_FORM);
    var isIdMismatch = false;

    if (sessionData) {
        try {
            var parsed = JSON.parse(sessionData);
            if (parsed.parts_id && String(parsed.parts_id) !== String(currentPartsId)) {
                isIdMismatch = true;
            }
        } catch(e) { isIdMismatch = true; }
    }

    if (!sessionData || isIdMismatch) {
        sessionStorage.removeItem(STORAGE_KEY_MAIN_FORM);
        toggleFieldsByType();
        
        var pType = document.getElementById('parts_type')?.value;
        if (pType === 'Multi Record Input' || pType === 'Multi Record Confirm') {
            syncDynamicInputRows();
        } else if (pType === 'Text Input' || pType === 'Text Confirm') {
            syncTextInputRows();
        }
        return;
    }

    try {
        var formData = JSON.parse(sessionData);
        if (formData.parts_name !== undefined) document.getElementById('parts_name').value = formData.parts_name;
        if (formData.parts_description !== undefined) document.getElementById('parts_description').value = formData.parts_description;
        if (formData.parts_type !== undefined) document.getElementById('parts_type').value = formData.parts_type;
        if (formData.table_name !== undefined && document.getElementById('table_name')) document.getElementById('table_name').value = formData.table_name; 
        
        if (formData.display_label) {
            var rad = document.querySelector('input[name="display_label"][value="' + formData.display_label + '"]');
            if(rad) {
                rad.checked = true;
                switchDisplayLabel(formData.display_label);
            }
        }
        if (formData.column_filter) {
            var radFilter = document.querySelector('input[name="column_filter"][value="' + formData.column_filter + '"]');
            if(radFilter) radFilter.checked = true;
        }
        if (formData.input_rows !== undefined && document.getElementById('input_rows')) document.getElementById('input_rows').value = formData.input_rows;
        if (formData.preview_title !== undefined) document.getElementById('preview_title').value = formData.preview_title;

        if (formData.input_style !== undefined) {
            var stylesArray = formData.input_style.split(',');
            document.querySelectorAll('.single-input-style-select, .multi-input-style-select').forEach(function(sel) {
                var idx = sel.getAttribute('data-index');
                if (stylesArray[idx] !== undefined) {
                    sel.value = stylesArray[idx];
                }
            });
        }

        if (formData.selected_columns && Array.isArray(formData.selected_columns)) {
            var lowerSelected = formData.selected_columns.map(function(v) { return String(v).toLowerCase().trim(); });
            document.querySelectorAll('input[name="selected_columns_vertical[]"], input[name="selected_columns_horizontal[]"]').forEach(function(chk) {
                var val = String(chk.value).toLowerCase().trim();
                chk.checked = lowerSelected.includes(val);
            });
        }

        if (formData.textinput_configs && Array.isArray(formData.textinput_configs)) {
            var jsonEle = document.getElementById('textinput_configs_json');
            if (jsonEle) jsonEle.value = JSON.stringify(formData.textinput_configs);
        }
    } catch(e) {}
    
    toggleFieldsByType();
    
    var finalType = document.getElementById('parts_type')?.value;
    if (finalType === 'Multi Record Input' || finalType === 'Multi Record Confirm') {
        syncDynamicInputRows();
    } else if (finalType === 'Text Input' || finalType === 'Text Confirm') {
        syncTextInputRows();
    }
});
</script>

