                        <option value="" <?= $current_type === '' ? 'selected' : '' ?>>-- 選択してください --</option>
                        <option value="Single Record Input" <?= $current_type === 'Single Record Input' ? 'selected' : '' ?>>Single Record Input</option>
                        <option value="Multi Record Input" <?= $current_type === 'Multi Record Input' ? 'selected' : '' ?>>Multi Record Input</option>
                        <option value="Text Input" <?= $current_type === 'Text Input' ? 'selected' : '' ?>>Text Input</option>
                        <option value="Single Record Confirm" <?= $current_type === 'Single Record Confirm' ? 'selected' : '' ?>>Single Record Confirm</option>
                        <option value="Multi Record Confirm" <?= $current_type === 'Multi Record Confirm' ? 'selected' : '' ?>>Multi Record Confirm</option>
                        <option value="Text Confirm" <?= $current_type === 'Text Confirm' ? 'selected' : '' ?>>Text Confirm</option>
                        <option value="Text Display" <?= $current_type === 'Text Display' ? 'selected' : '' ?>>Text Display</option>
                        <option value="Style Display" <?= $current_type === 'Style Display' ? 'selected' : '' ?>>Style Display</option>
