<div class="designer-base" style="padding: 20px; box-sizing: border-box; background-color: transparent; font-family: 'Helvetica Neue', Arial, sans-serif; font-size: 13px;">
    <div class="title" style="font-size: 14px; font-weight: bold; margin-bottom: 25px; border-bottom: 1px solid #ccc; padding-bottom: 10px;">
        画面パーツ詳細設定 [<?= htmlspecialchars($row_pos ?? '1', ENT_QUOTES, 'UTF-8') ?>,<?= htmlspecialchars($col_pos ?? '1', ENT_QUOTES, 'UTF-8') ?>]
    </div>

    <div style="background-color: transparent; margin-bottom: 5px; max-width: 1000px;">
        <table class="detail-config-table" style="border-collapse: collapse; width: 100%; font-size: 13px;">
            <tr style="height: 35px;">
                <th style="width: 140px; text-align: left; font-weight: normal; padding: 4px 0; white-space: nowrap;">画面パーツ名称</th>
                <td colspan="2" style="padding: 4px 0;">
                    <div style="width: 500px; border: 1px solid #000; padding: 4px 6px; background-color: #e0e0e0; font-size: 13px; box-sizing: border-box; min-height: 26px;">
                        <?= htmlspecialchars($parts_name ?? '', ENT_QUOTES, 'UTF-8') ?>
                    </div>
                </td>
            </tr>
            <tr style="height: 35px;">
                <th style="text-align: left; font-weight: normal; padding: 4px 0; white-space: nowrap;">内容の説明</th>
                <td colspan="2" style="padding: 4px 0;">
                    <div style="width: 750px; border: 1px solid #000; padding: 4px 6px; background-color: #e0e0e0; font-size: 13px; box-sizing: border-box; min-height: 26px;">
                        <?= htmlspecialchars($parts_description ?? '', ENT_QUOTES, 'UTF-8') ?>
                    </div>
                </td>
            </tr>
            
            <tr style="height: 15px;"><td colspan="3"></td></tr>

            <tr style="height: 35px;">
                <th style="text-align: left; font-weight: normal; padding: 4px 0;">
                    [ <?= htmlspecialchars($row_pos ?? '1', ENT_QUOTES, 'UTF-8') ?>, <?= htmlspecialchars($col_pos ?? '1', ENT_QUOTES, 'UTF-8') ?> ]
                </th>
                <td style="padding: 4px 0; width: 508px;">
                    <div style="width: 500px; border: 1px solid #000; padding: 4px 6px; background-color: #e0e0e0; font-size: 13px; font-weight: bold; box-sizing: border-box; min-height: 26px;">
                        <?= ($selected_type === '') ? '--' : htmlspecialchars($selected_type, ENT_QUOTES, 'UTF-8') ?>
                    </div>
                </td>
                <td style="padding: 4px 0; text-align: left; vertical-align: middle; white-space: nowrap;">
                    <button type="button" class="btn-cancel" style="background-color: #757575; color: white; border: none; padding: 5px 20px; border-radius: 4px; font-weight: bold; cursor: pointer; font-size: 12px; height: 26px; line-height: 16px; box-sizing: border-box; margin-left: 10px;" onclick="cancelAndReturn();">キャンセル</button>
                    <button type="button" class="btn-save" style="background-color: #1e88e5; color: white; border: none; padding: 5px 24px; border-radius: 4px; font-weight: bold; cursor: pointer; font-size: 12px; height: 26px; line-height: 16px; box-sizing: border-box; margin-left: 10px;" onclick="saveConfig();">保存</button>
                </td>
            </tr>

            <tr style="height: 35px;">
                <th style="text-align: left; font-weight: normal; padding: 4px 0; white-space: nowrap;">参照テーブル</th>
                <td colspan="2" style="padding: 4px 0;">
                    <select id="ref_table" onchange="onTableSelectChange();" disabled style="width: 500px; border: 1px solid #000; padding: 4px; background: #f5f5f5; outline: none; font-size: 13px; box-sizing: border-box;">
                        <option value="">-- 種別を先に選択してください --</option>
                    </select>
                </td>
            </tr>

            <tr style="height: 35px;">
                <th style="text-align: left; font-weight: normal; padding: 4px 0; white-space: nowrap;">表示項目選択</th>
                <td colspan="2" style="padding: 4px 0; vertical-align: middle;">
                    <label style="margin-right: 20px; cursor: pointer; font-size: 13px;">
                        <input type="radio" name="display_label_radio" value="physical" checked onchange="renderPreviewGrid();" style="vertical-align: middle; margin-top: -2px;"> 物理名
                    </label>
                    <label style="cursor: pointer; font-size: 13px;">
                        <input type="radio" name="display_label_radio" value="logical" onchange="renderPreviewGrid();" style="vertical-align: middle; margin-top: -2px;"> 日本語名
                    </label>
                </td>
            </tr>
        </table>
    </div>

    <div id="preview-layout-zone" style="margin-top: 0px; max-width: 700px; display: none;">
        
        <div style="font-size: 12px; font-weight: bold; color: #555; margin-top: 5px; margin-bottom: 10px;">▼ 縦型配置プレビュー</div>

        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; border-bottom: 1px dashed #ccc; padding-bottom: 8px;">
            <div style="display: flex; align-items: center; flex: 1; max-width: 480px;">
                <input type="text" id="preview_header_title" style="width: 100%; border: 1px solid #000; padding: 4px 8px; font-size: 13px; box-sizing: border-box; outline: none; height: 26px;" placeholder="プレビュータイトルの入力">
            </div>
            
            <div style="font-size: 12px; color: #333; white-space: nowrap; margin-left: 15px;">
                <label style="margin-right: 15px; cursor: pointer;">
                    <input type="radio" name="column_filter_radio" value="all" checked onchange="renderPreviewGrid();" style="vertical-align: middle; margin-top: -2px;"> 全カラム
                </label>
                <label style="cursor: pointer;">
                    <input type="radio" name="column_filter_radio" value="selected" onchange="renderPreviewGrid();" style="vertical-align: middle; margin-top: -2px;"> 表示カラムだけ
                </label>
            </div>
        </div>
        
        <div id="dynamic-grid-container" style="display: flex; flex-direction: column;"></div>
    </div>
</div>

<script>
if (typeof bridge === 'undefined' && typeof parent !== 'undefined' && typeof parent.bridge === 'function') {
    var bridge = parent.bridge;
}

var rawMasterTables = <?= $m_tables_json ?? '[]' ?>;
var currentColumns = <?= $m_columns_json ?? '[]' ?>;
var checkedStatusMap = {};

function onLayoutTypeChange() {
    var typeSelect = '<?= htmlspecialchars($selected_type ?? "", ENT_QUOTES, "UTF-8") ?>';
    var tableSelect = document.getElementById('ref_table');
    
    tableSelect.innerHTML = '<option value="">-- 選択してください --</option>';
    tableSelect.disabled = true;
    tableSelect.style.background = '#f5f5f5';
    clearPreview();

    if (typeSelect === 'Single Record 入力' || typeSelect === 'Multi Record 入力') {
        tableSelect.disabled = false;
        tableSelect.style.background = '#fff';
        
        if (rawMasterTables && rawMasterTables.length > 0) {
            rawMasterTables.forEach(function(table) {
                var tId   = String(table.table_id ?? '').trim();
                var pName = String(table.physical_name ?? '').trim();
                var lName = String(table.logical_name ?? '').trim();
                
                if (tId === '' || pName === '') return;
                
                var displayText = tId + ' ' + pName + (lName ? ' ' + lName : '');
                
                var opt = document.createElement('option');
                opt.value = tId;
                opt.textContent = displayText;
                tableSelect.appendChild(opt);
            });
        }
    } else if (typeSelect !== '') {
        tableSelect.innerHTML = '<option value="">-- この種別は参照テーブル不要です --</option>';
    } else {
        tableSelect.innerHTML = '<option value="">-- 種別を先に選択してください --</option>';
    }
}

function onTableSelectChange() {
    var tableSelect = document.getElementById('ref_table').value;
    var zone = document.getElementById('preview-layout-zone');
    var container = document.getElementById('dynamic-grid-container');
    
    clearPreview();
    if (tableSelect === '') return;
    
    zone.style.display = 'block';
    container.innerHTML = '<div style="padding: 10px; color: #666; font-size: 12px;">カラム情報を読み込み中...</div>';

    bridge({
        code: 'PartsDefinition/getColumns',
        table_id: tableSelect,
        row_pos: '<?= htmlspecialchars($row_pos ?? "1", ENT_QUOTES, "UTF-8") ?>',
        col_pos: '<?= htmlspecialchars($col_pos ?? "1", ENT_QUOTES, "UTF-8") ?>',
        selected_type: '<?= htmlspecialchars($selected_type ?? "", ENT_QUOTES, "UTF-8") ?>',
        parts_name: '<?= htmlspecialchars($parts_name ?? "", ENT_QUOTES, "UTF-8") ?>',
        parts_description: '<?= htmlspecialchars($parts_description ?? "", ENT_QUOTES, "UTF-8") ?>',
        layout_type: '<?= htmlspecialchars($selected_type ?? "", ENT_QUOTES, "UTF-8") ?>'
    });
}

function renderPreviewGrid() {
    var container = document.getElementById('dynamic-grid-container');
    if (!currentColumns || currentColumns.length === 0) {
        container.innerHTML = '';
        return;
    }

    var labelType = document.querySelector('input[name="display_label_radio"]:checked').value;
    var filterType = document.querySelector('input[name="column_filter_radio"]:checked').value;
    
    var gapSize = 0;
    var html = '';
    var renderedCount = 0;

    currentColumns.forEach(function(col) {
        if (!col.physical_name) return;

        var pName = col.physical_name;
        if (checkedStatusMap[pName] === undefined) {
            checkedStatusMap[pName] = true;
        }

        var isChecked = checkedStatusMap[pName];

        if (filterType === 'selected' && !isChecked) {
            return;
        }

        var displayText = (labelType === 'logical') ? (col.logical_name || pName) : pName;
        
        var marginTopStyle = (renderedCount > 0) ? 'margin-top: -1px;' : 'margin-top: 0px;';
        renderedCount++;

        html += '<div class="preview-row" style="display: flex; width: 100%; min-height: 40px; align-items: stretch; ' + marginTopStyle + ' margin-bottom: ' + gapSize + 'px;">';
        html += '  <div style="width: 40px; border: 1px solid #000; background-color: #f9f9f9; display: flex; justify-content: center; align-items: center; box-sizing: border-box;">';
        html += '    <input type="checkbox" data-pname="' + escapeHtml(pName) + '" ' + (isChecked ? 'checked' : '') + ' onchange="onColumnCheckChange(this);" style="transform: scale(1.1); cursor: pointer;">';
        html += '  </div>';
        html += '  <div style="width: 200px; border: 1px solid #000; border-left: none; background-color: #fff; display: flex; align-items: center; justify-content: center; padding: 4px; box-sizing: border-box; font-size: 12px; font-weight: bold; text-align: center; line-height: 1.3;">';
        html += '    <div>' + escapeHtml(displayText) + '</div>';
        html += '  </div>';
        html += '  <div style="flex: 1; border: 1px solid #000; border-left: none; background-color: #fff; padding: 6px; box-sizing: border-box; display: flex; align-items: center;">';
        html += '    <input type="text" style="width: 95%; border: 1px solid #ccc; padding: 4px; outline: none; font-size: 13px;" placeholder="入力してください">';
        html += '  </div>';
        html += '</div>';
    });
    container.innerHTML = html;
}

function onColumnCheckChange(chk) {
    var pName = chk.getAttribute('data-pname');
    checkedStatusMap[pName] = chk.checked;

    var filterType = document.querySelector('input[name="column_filter_radio"]:checked').value;
    if (filterType === 'selected') {
        renderPreviewGrid();
    }
}

function clearPreview() {
    document.getElementById('preview-layout-zone').style.display = 'none';
    document.getElementById('dynamic-grid-container').innerHTML = '';
    var titleInput = document.getElementById('preview_header_title');
    if (titleInput) titleInput.value = '';
    checkedStatusMap = {};
}

function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
}

// 💡 キャンセルボタン押下時の処理
function cancelAndReturn() {
    var cancelBtn = document.querySelector('.btn-cancel');
    if (cancelBtn) {
        cancelBtn.style.backgroundColor = '#aaa';
        cancelBtn.disabled = true;
    }
    bridge({ code: 'PartsDefinition/cancel' });
}

// 💡 保存ボタン押下時の処理（必要に応じて送信データの構成を調整してください）
function saveConfig() {
    var saveBtn = document.querySelector('.btn-save');
    if (saveBtn) {
        saveBtn.style.backgroundColor = '#aaa';
        saveBtn.disabled = true;
    }
    
    // チェックボックスの状態等から保存用のカラム配列をパース
    var columnsData = [];
    currentColumns.forEach(function(col) {
        if (!col.physical_name) return;
        columnsData.push({
            physical_name: col.physical_name,
            logical_name: col.logical_name || '',
            is_checked: (checkedStatusMap[col.physical_name] !== false) ? 1 : 0
        });
    });

    bridge({ 
        code: 'PartsDefinition/save',
        table_id: document.getElementById('ref_table').value,
        preview_title: document.getElementById('preview_header_title').value || '',
        display_label: document.querySelector('input[name="display_label_radio"]:checked').value,
        columns: columnsData
    });
}

// ==========================================
// 初期展開時の制御自動実行
// ==========================================
(function() {
    onLayoutTypeChange();
    
    if (currentColumns && currentColumns.length > 0) {
        var tableSelect = document.getElementById('ref_table');
        if (rawMasterTables && rawMasterTables.length > 0) {
            for (var i = 0; i < tableSelect.options.length; i++) {
                if (tableSelect.options[i].value !== "") {
                    tableSelect.selectedIndex = i; 
                    break;
                }
            }
        }
        
        document.getElementById('preview-layout-zone').style.display = 'block';
        renderPreviewGrid();
    }
})();
</script>
