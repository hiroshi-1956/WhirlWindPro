<?php
/**
 * single_record_confirm.view (Single Record Confirm / 拡張設定部分)
 * - 参照テーブルと画面タイトルの幅を「画面パーツ名称」などの標準幅（例: 520px）に合わせた版
 */
if (!function_exists('convertToDeveloperVariableNamePHP')) {
    function convertToDeveloperVariableNamePHP($str) {
        if (empty($str)) return '';
        $camel = str_replace(' ', '', ucwords(str_replace('_', ' ', strtolower($str))));
        $camel = lcfirst($camel);
        return 'developers::' . $camel;
    }
}

$textinput_configs = $textinput_configs ?? [];
$isEditMode = !empty($is_edit);
?>

<input type="hidden" id="is_edit_mode_flag" value="<?= $isEditMode ? '1' : '0'; ?>">
<input type="hidden" id="grids_config_json" name="grids_config_json" value="<?= htmlspecialchars($grids_config_json ?? '{}', ENT_QUOTES, 'UTF-8') ?>">
<input type="hidden" id="textinput_configs_json" value="<?= htmlspecialchars(json_encode($textinput_configs, JSON_UNESCAPED_UNICODE), ENT_QUOTES, 'UTF-8') ?>">

<!-- 選択されたカラムを確実にサーバーへ送信するための隠しフィールド -->
<input type="hidden" id="checked_columns_json" name="checked_columns_json" value="<?= htmlspecialchars(is_array($checked_columns ?? null) ? implode(',', $checked_columns) : ($checked_columns ?? ''), ENT_QUOTES, 'UTF-8') ?>">

<div id="single-record-confirm-fields-container" style="display: block; margin-top: 0;">
    <table class="extended-table" style="border-collapse: collapse; width: 100%; border: none;">
        
        <tr id="row-table-id" style="height: 40px;">
            <th style="width: 120px; text-align: left; font-weight: normal; font-size: 14px; padding: 0; vertical-align: middle;">参照テーブル</th>
            <td style="padding: 0; vertical-align: middle;">
                <div style="display: flex; align-items: center; width: 520px; height: 30px; border: 2px solid #000; background: #fff; box-sizing: border-box; padding: 0;">
                    <select id="table_name" name="table_name" style="width: 100%; height: 100%; border: none; background: transparent; padding: 0 6px; outline: none; font-size: 14px; cursor: pointer;" onchange="loadColumnsFromDB(); saveMainForm();">
                        <option value="">-- テーブルを選択してください --</option>
                        <?php if (!empty($m_tables) && is_array($m_tables)): ?>
                            <?php foreach ($m_tables as $tbl): ?>
                                <?php 
                                    $t_id   = $tbl['table_id'] ?? ''; 
                                    $p_name = $tbl['physical_name'] ?? '';
                                    $l_name = $tbl['logical_name'] ?? '';
                                    $display_text = $p_name . ($l_name ? " ({$l_name})" : "");
                                    
                                    $selected = '';
                                    if (isset($table_name) && ((string)$table_name === (string)$t_id || (string)$table_name === (string)$p_name)) {
                                        $selected = 'selected';
                                    }
                                ?>
                                <option value="<?= htmlspecialchars($p_name, ENT_QUOTES, 'UTF-8') ?>" data-id="<?= htmlspecialchars($t_id, ENT_QUOTES, 'UTF-8') ?>" <?= $selected ?>>
                                    <?= htmlspecialchars($display_text, ENT_QUOTES, 'UTF-8') ?>
                                </option>
                            <?php endforeach; ?>
                        <?php endif; ?>
                    </select>
                </div>
            </td>
        </tr>
        
        <tr id="row-display-label" style="height: 40px;">
            <th style="width: 120px; text-align: left; font-weight: normal; font-size: 14px; padding: 0; vertical-align: middle;">表示項目選択</th>
            <td style="padding: 0; vertical-align: middle;">
                <div style="display: flex; align-items: center; gap: 40px; height: 30px; font-size: 14px; padding-left: 0;">
                    <?php $current_display = $display_label ?? 'physical'; ?>
                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                        <input type="radio" name="display_label" value="physical" <?= $current_display === 'physical' ? 'checked' : '' ?> onchange="switchDisplayLabel('physical'); saveMainForm();"> 物理名
                    </label>
                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                        <input type="radio" name="display_label" value="logical" <?= $current_display === 'logical' ? 'checked' : '' ?> onchange="switchDisplayLabel('logical'); saveMainForm();"> 日本語名
                    </label>
                </div>
            </td>
        </tr>
        
        <tr id="row-column-filter" style="height: 40px;">
            <th style="width: 120px; text-align: left; font-weight: normal; font-size: 14px; padding: 0; vertical-align: middle;">表示カラム</th>
            <td style="padding: 0; vertical-align: middle;">
                <div style="display: flex; align-items: center; gap: 40px; height: 30px; font-size: 14px; padding-left: 0;">
                    <?php $current_filter = $column_filter ?? 'all'; ?>
                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                        <input type="radio" name="column_filter" value="all" <?= $current_filter === 'all' ? 'checked' : '' ?> onchange="toggleColumnListVisibility(); saveMainForm();"> 全カラム
                    </label>
                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                        <input type="radio" name="column_filter" value="selected" <?= $current_filter === 'selected' ? 'checked' : '' ?> onchange="toggleColumnListVisibility(); saveMainForm();"> 表示カラムだけ
                    </label>
                </div>
            </td>
        </tr>

        <tr id="row-preview-title" style="height: 40px;">
            <th style="width: 120px; text-align: left; font-weight: normal; font-size: 14px; padding: 0; vertical-align: middle;">画面タイトル</th>
            <td style="padding: 0; vertical-align: middle;">
                <input type="text" id="preview_title" name="preview_title" style="width: 520px; height: 30px; border: 2px solid #000; padding: 0 6px; background: #fff; box-sizing: border-box; outline: none; font-size: 14px;" value="<?= htmlspecialchars($preview_title ?? '', ENT_QUOTES, 'UTF-8'); ?>" oninput="saveMainForm();">
            </td>
        </tr>
    </table>

    <!-- 3列構成のテーブル表示エリア（横幅を 520px に統一し、横スクロールを抑制） -->
    <div id="column-list-wrapper" style="display: <?= !empty($table_name) ? 'block' : 'none'; ?>; margin-top: 15px; margin-left: 120px; width: 520px; box-sizing: border-box;">		            
        <div id="container-layout-vertical" style="width: 100%; border: 2px solid #000; background-color: #fff; box-sizing: border-box; max-height: 400px; overflow-y: auto; overflow-x: hidden;">
            <table id="vertical-columns-table" style="border-collapse: collapse; width: 100%; font-size: 14px; background-color: #fff; table-layout: fixed;">
                <tbody>
                    <?php if (!empty($m_partsinfo_columns)): ?>
                        <?php foreach ($m_partsinfo_columns as $idx => $col): ?>
                            <?php 
                                $p_col = $col['physical_name'] ?? ''; 
                                $l_col = $col['logical_name'] ?? ''; 
                                if (empty($l_col) || $l_col === '&nbsp;') { $l_col = $p_col; }
                                $middle_label = ($current_display === 'physical') ? $p_col : $l_col;

                                $isChecked = false;
                                if (empty($is_edit)) {
                                    $isChecked = true;
                                } else if (!empty($checked_columns) && is_array($checked_columns)) {
                                    $lower_checked = array_map('strtolower', $checked_columns);
                                    if (in_array(strtolower($p_col), $lower_checked)) {
                                        $isChecked = true;
                                    }
                                }
                            ?>
                            <tr class="vertical-column-row" data-physical="<?= htmlspecialchars($p_col, ENT_QUOTES, 'UTF-8') ?>" data-logical="<?= htmlspecialchars($l_col, ENT_QUOTES, 'UTF-8') ?>" style="border-bottom: 1px solid #ccc;">
                                <!-- 1列目: 選択チェックボックス（幅40px） -->
                                <td style="width: 40px; text-align: center; border-right: 1px solid #ccc; padding: 8px; background-color: #fff;">
                                    <input type="checkbox" name="selected_columns_horizontal[]" value="<?= htmlspecialchars($p_col, ENT_QUOTES, 'UTF-8') ?>" data-index="<?= $idx ?>" onchange="toggleColumnListVisibility(); saveMainForm();" <?= $isChecked ? 'checked' : '' ?> style="transform: scale(1.1); cursor: pointer;">
                                </td>
                                <!-- 2列目: 項目名（幅240px） -->
                                <td class="vertical-label-cell" data-physical="<?= htmlspecialchars($p_col, ENT_QUOTES, 'UTF-8') ?>" data-logical="<?= htmlspecialchars($l_col, ENT_QUOTES, 'UTF-8') ?>" style="width: 240px; padding: 8px 12px; text-align: left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; border-right: 1px solid #ccc;" title="<?= htmlspecialchars($middle_label, ENT_QUOTES, 'UTF-8') ?>">
                                    <?= htmlspecialchars($middle_label, ENT_QUOTES, 'UTF-8') ?>
                                </td>
                                <!-- 3列目: 空白セル（幅240px：合計520pxに収める） -->
                                <td style="width: 240px; height: 28px; padding: 8px; background-color: #fff; vertical-align: middle;">&nbsp;</td>
                            </tr>
                        <?php endforeach; ?>
                    <?php endif; ?>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
let cachedColumnsData = null;

function switchDisplayLabel(type) {
    const labelCells = document.querySelectorAll('.vertical-label-cell');
    labelCells.forEach(td => {
        const physicalName = td.getAttribute('data-physical');
        const logicalName = td.getAttribute('data-logical');

        if (type === 'physical') {
            td.textContent = physicalName;
            td.setAttribute('title', physicalName);
        } else {
            const label = (logicalName && logicalName !== '&nbsp;') ? logicalName : physicalName;
            td.textContent = label;
            td.setAttribute('title', label);
        }
    });
}

function toggleColumnListVisibility() {
    const filterRadio = document.querySelector('input[name="column_filter"]:checked');
    const filterType = filterRadio ? filterRadio.value : 'all';
    
    const rows = document.querySelectorAll('.vertical-column-row');
    rows.forEach(row => {
        const checkbox = row.querySelector('input[type="checkbox"]');
        if (!checkbox) return;

        let show = true;
        if (filterType === 'selected' && !checkbox.checked) {
            show = false;
        }

        row.style.display = show ? '' : 'none';
    });
}

function loadColumnsFromDB() {
    const tableSelect = document.getElementById('table_name');
    const selectedTableName = tableSelect ? tableSelect.value : '';
    const columnListWrapper = document.getElementById('column-list-wrapper');
    const verticalTableBody = document.querySelector('#vertical-columns-table tbody');

    const isEditMode = document.getElementById('is_edit_mode_flag') && document.getElementById('is_edit_mode_flag').value === '1';

    if (isEditMode) {
        const formInputs = document.querySelectorAll('input[type="text"], input[type="number"], textarea');
        formInputs.forEach((el, idx) => {
            const key = 'backup_input_' + (el.id || el.name || idx);
            if (el.value) {
                localStorage.setItem(key, el.value);
            }
        });
    }

    if (!selectedTableName) {
        if (columnListWrapper) columnListWrapper.style.display = 'none';
        if (verticalTableBody) verticalTableBody.innerHTML = '';
        cachedColumnsData = null;
        if (typeof saveMainForm === 'function') saveMainForm();
        return;
    }

    if (typeof window.bridge === 'function') {
        window.bridge({
            code: 'PartsDefinition/getColumns',
            table_name: selectedTableName,
            parts_type: document.getElementById('parts_type') ? document.getElementById('parts_type').value : 'Single Record Confirm',
            parts_id: document.getElementById('parts_id') ? document.getElementById('parts_id').value : '',
            parts_name: document.getElementById('parts_name') ? document.getElementById('parts_name').value : '',
            parts_description: document.getElementById('parts_description') ? document.getElementById('parts_description').value : '',
            preview_title: document.getElementById('preview_title') ? document.getElementById('preview_title').value : ''
        }, function(response) {
            if (response && response.columns) {
                cachedColumnsData = response.columns;
                renderVerticalColumns(response.columns);
                if (columnListWrapper) columnListWrapper.style.display = 'block';
                toggleColumnListVisibility();

                if (isEditMode) {
                    const currentInputs = document.querySelectorAll('input[type="text"], input[type="number"], textarea');
                    currentInputs.forEach((el, idx) => {
                        const key = 'backup_input_' + (el.id || el.name || idx);
                        const savedVal = localStorage.getItem(key);
                        if (savedVal && !el.value) {
                            el.value = savedVal;
                        }
                    });
                }

                if (typeof saveMainForm === 'function') saveMainForm();
            }
        });
    }
}

function renderVerticalColumns(columns) {
    const verticalTableBody = document.querySelector('#vertical-columns-table tbody');
    const displayLabelRadio = document.querySelector('input[name="display_label"]:checked');
    const isPhysical = displayLabelRadio ? displayLabelRadio.value === 'physical' : true;

    const existingCheckboxes = {};

    if (verticalTableBody) {
        const rows = verticalTableBody.querySelectorAll('tr.vertical-column-row');
        rows.forEach(row => {
            const chk = row.querySelector('input[type="checkbox"]');
            if (chk) {
                existingCheckboxes[chk.value] = chk.checked;
            }
        });
    }

    let html = '';
    columns.forEach((col, idx) => {
        const pCol = col.physical_name || '';
        let lCol = col.logical_name || '';
        if (!lCol) { lCol = pCol; }
        const middleLabel = isPhysical ? pCol : lCol;

        let isChecked = true;
        if (existingCheckboxes.hasOwnProperty(pCol)) {
            isChecked = existingCheckboxes[pCol];
        }

        html += `<tr class="vertical-column-row" data-physical="${escapeHtml(pCol)}" data-logical="${escapeHtml(lCol)}" style="border-bottom: 1px solid #ccc;">`;
        // 1列目: 選択チェックボックス
        html += `<td style="width: 40px; text-align: center; border-right: 1px solid #ccc; padding: 8px; background-color: #fff;">`;
        html += `<input type="checkbox" name="selected_columns_horizontal[]" value="${escapeHtml(pCol)}" data-index="${idx}" onchange="toggleColumnListVisibility(); saveMainForm();" ${isChecked ? 'checked' : ''} style="transform: scale(1.1); cursor: pointer;">`;
        html += `</td>`;
        // 2列目: 項目名
        html += `<td class="vertical-label-cell" data-physical="${escapeHtml(pCol)}" data-logical="${escapeHtml(lCol)}" style="width: 240px; padding: 8px 12px; text-align: left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; border-right: 1px solid #ccc;" title="${escapeHtml(middleLabel)}">${escapeHtml(middleLabel)}</td>`;
        // 3列目: 空白セル
        html += `<td style="width: 240px; height: 28px; padding: 8px; background-color: #fff; vertical-align: middle;">&nbsp;</td>`;
        html += `</tr>`;
    });

    if (verticalTableBody) {
        verticalTableBody.innerHTML = html;
    }
}

function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/[&'`<>"]/g, function(match) {
        return {
            '&': '&amp;',
            "'": '&#x27;',
            '`': '&#x60;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;'
        }[match];
    });
}

document.addEventListener('DOMContentLoaded', function() {
    const isEditMode = document.getElementById('is_edit_mode_flag') && document.getElementById('is_edit_mode_flag').value === '1';

    if (isEditMode) {
        const currentInputs = document.querySelectorAll('input[type="text"], input[type="number"], textarea');
        currentInputs.forEach((el, idx) => {
            const key = 'backup_input_' + (el.id || el.name || idx);
            const savedVal = localStorage.getItem(key);
            if (savedVal && !el.value) {
                el.value = savedVal;
            }
        });
    }

    // 種類（parts_type）のプルダウンを固定（無効化）する処理
    const partsTypeEl = document.getElementById('parts_type') || document.querySelector('[name="parts_type"]');
    if (partsTypeEl) {
        partsTypeEl.disabled = true;
        partsTypeEl.style.backgroundColor = '#f0f0f0';
        partsTypeEl.style.cursor = 'not-allowed';
    }

    const rows = document.querySelectorAll('.vertical-column-row');
    if (rows.length > 0) {
        cachedColumnsData = [];
        rows.forEach(row => {
            cachedColumnsData.push({
                physical_name: row.getAttribute('data-physical'),
                logical_name: row.getAttribute('data-logical')
            });
        });
    }

    toggleColumnListVisibility();
});

function updateSerializedData() {
    const rows = document.querySelectorAll('.vertical-column-row');
    const checkedColumns = [];

    rows.forEach(row => {
        const checkbox = row.querySelector('input[type="checkbox"]');
        const physicalName = row.getAttribute('data-physical');

        if (!physicalName) return;

        if (checkbox && checkbox.checked) {
            checkedColumns.push(physicalName);
        }
    });

    const checkedJsonEl = document.getElementById('checked_columns_json');
    if (checkedJsonEl) {
        checkedJsonEl.value = checkedColumns.join(',');
    }
}

function saveMainForm() {
    if (typeof updateSerializedData === 'function') {
        updateSerializedData();
    }
}
</script>
