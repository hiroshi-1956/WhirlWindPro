<script>
let cachedColumnsData = null;

function switchDisplayLabel(type) {
    const headers = document.querySelectorAll('.horizontal-label-cell, .confirm-label-cell');
    headers.forEach(th => {
        const physicalName = th.getAttribute('data-physical');
        const logicalName = th.getAttribute('data-logical');

        if (type === 'physical') {
            th.textContent = physicalName;
            th.setAttribute('title', physicalName);
        } else {
            const label = (logicalName && logicalName !== '&nbsp;') ? logicalName : physicalName;
            th.textContent = label;
            th.setAttribute('title', label);
        }
    });
}

function toggleColumnListVisibility() {
    const filterRadio = document.querySelector('input[name="column_filter"]:checked');
    const filterType = filterRadio ? filterRadio.value : 'all';
    
    const table = document.getElementById('horizontal-columns-table');
    if (table) {
        const checkboxCells = table.querySelectorAll('tr:nth-child(1) td');
        const headerCells = table.querySelectorAll('tr:nth-child(2) th:not(:first-child)');
        const previewCells = table.querySelectorAll('tr:nth-child(3) td');
        const allRows = table.querySelectorAll('tr');

        headerCells.forEach((th, idx) => {
            const chkCell = checkboxCells[idx];
            const prevCell = previewCells[idx];
            if (!chkCell) return;

            const checkbox = chkCell.querySelector('input[type="checkbox"]');
            if (!checkbox) return;

            let show = true;
            if (filterType === 'selected' && !checkbox.checked) {
                show = false;
            }

            const displayStyle = show ? '' : 'none';
            th.style.display = displayStyle;
            chkCell.style.display = displayStyle;
            if (prevCell) prevCell.style.display = displayStyle;

            for (let r = 3; r < allRows.length; r++) {
                const rowCells = allRows[r].querySelectorAll('td');
                if (rowCells[idx]) {
                    rowCells[idx].style.display = displayStyle;
                }
            }
        });
    }

    const confirmRows = document.querySelectorAll('.confirm-column-row');
    confirmRows.forEach(cRow => {
        cRow.style.display = '';
    });
}

function onRowCountChange() {
    if (cachedColumnsData && cachedColumnsData.length > 0) {
        renderHorizontalColumns(cachedColumnsData);
        toggleColumnListVisibility();
    } else {
        loadColumnsFromDB();
    }
}

function loadColumnsFromDB() {
    const tableSelect = document.getElementById('table_name');
    const selectedTableName = tableSelect.value;
    const columnListWrapper = document.getElementById('column-list-wrapper');
    const horizontalTable = document.getElementById('horizontal-columns-table');
    const confirmTableBody = document.querySelector('#confirm-columns-table tbody');

    if (!selectedTableName) {
        if (columnListWrapper) columnListWrapper.style.display = 'none';
        if (horizontalTable) horizontalTable.innerHTML = '';
        if (confirmTableBody) confirmTableBody.innerHTML = '';
        cachedColumnsData = null;
        if (typeof saveMainForm === 'function') saveMainForm();
        return;
    }

    if (typeof window.bridge === 'function') {
        window.bridge({
            code: 'PartsDefinition/getColumns',
            table_name: selectedTableName,
            parts_type: document.getElementById('parts_type') ? document.getElementById('parts_type').value : 'Multi Record Input',
            parts_id: document.getElementById('parts_id') ? document.getElementById('parts_id').value : '',
            preview_title: document.getElementById('preview_title') ? document.getElementById('preview_title').value : '',
            input_rows: document.getElementById('input_rows') ? document.getElementById('input_rows').value : '3'
        }, function(response) {
            if (response && response.columns) {
                cachedColumnsData = response.columns;
                renderHorizontalColumns(response.columns);
                renderConfirmSection(response.columns, selectedTableName);
                if (columnListWrapper) columnListWrapper.style.display = 'block';
                toggleColumnListVisibility();
                if (typeof saveMainForm === 'function') saveMainForm();
            }
        });
    }
}

function renderHorizontalColumns(columns) {
    const horizontalTable = document.getElementById('horizontal-columns-table');
    const displayLabelRadio = document.querySelector('input[name="display_label"]:checked');
    const isPhysical = displayLabelRadio ? displayLabelRadio.value === 'physical' : true;
    const inputRowsEl = document.getElementById('input_rows');
    const rowCount = inputRowsEl ? Math.max(1, parseInt(inputRowsEl.value) || 3) : 3;
    const tableSelect = document.getElementById('table_name');
    const currentTableName = tableSelect ? tableSelect.value : 'テーブル名';

    const existingCheckboxes = {};
    const existingStyles = {};
    const existingCellValues = {};

    if (horizontalTable) {
        const oldCheckCells = horizontalTable.querySelectorAll('tr:nth-child(1) td');
        const oldRows = horizontalTable.querySelectorAll('tr');
        
        oldCheckCells.forEach((chkCell, idx) => {
            const chk = chkCell.querySelector('input[type="checkbox"]');
            if (chk) {
                existingCheckboxes[chk.value] = chk.checked;
            }
        });

        for (let r = 3; r < oldRows.length; r++) {
            const rowCells = oldRows[r].querySelectorAll('td');
            rowCells.forEach((cell, idx) => {
                const sel = cell.querySelector('select.multi-input-style-select');
                if (sel) {
                    const physicalName = sel.getAttribute('data-physical');
                    existingStyles[physicalName] = sel.value;
                }
                const inputVal = cell.querySelector('input.multi-input-cell-value');
                if (inputVal) {
                    const colIdx = inputVal.getAttribute('data-index');
                    const rowNum = inputVal.getAttribute('data-row');
                    existingCellValues[colIdx + '_' + rowNum] = inputVal.value;
                }
            });
        }
    }

    let checkboxHtml = '<tr style="border-bottom: 1px solid #ccc; background-color: #fafafa;"><th style="width: 60px; padding: 6px 8px; font-weight: bold; color: #000; border-right: 1px solid #ccc; text-align: center; white-space: nowrap; background-color: #fafafa;">選択</th>';
    let headerHtml   = '<tr style="border-bottom: 1px solid #ccc;"><th style="width: 60px; padding: 6px 8px; font-weight: bold; color: #000; border-right: 1px solid #ccc; text-align: center; white-space: nowrap; background-color: #fafafa;">項目名</th>';
    let previewHtml  = '<tr style="border-bottom: 1px solid #ccc;"><th style="width: 60px; padding: 6px 8px; font-weight: bold; color: #000; border-right: 1px solid #ccc; text-align: center; white-space: nowrap; background-color: #fafafa;">プレビュー</th>';
    
    let rowHtmls = {};
    for (let r = 1; r <= rowCount; r++) {
        rowHtmls[r] = `<tr><th style="width: 60px; padding: 6px 8px; font-weight: bold; color: #000; border-right: 1px solid #ccc; text-align: center; white-space: nowrap; background-color: #fafafa;">${r}</th>`;
    }

    columns.forEach((col, idx) => {
        const pCol = col.physical_name || '';
        let lCol = col.logical_name || '';
        if (!lCol) { lCol = pCol; }
        const middleLabel = isPhysical ? pCol : lCol;

        let isChecked = true;
        if (existingCheckboxes.hasOwnProperty(pCol)) {
            isChecked = existingCheckboxes[pCol];
        }

        checkboxHtml += `<td class="horizontal-item-cell" data-index="${idx}" style="text-align: center; border-right: 1px solid #ccc; padding: 6px 8px; background-color: #fff;">`;
        checkboxHtml += `<input type="checkbox" name="selected_columns_horizontal[]" value="${escapeHtml(pCol)}" data-index="${idx}" onchange="toggleColumnListVisibility(); saveMainForm();" ${isChecked ? 'checked' : ''} style="transform: scale(1.1); cursor: pointer;">`;
        checkboxHtml += `</td>`;

        headerHtml   += `<th class="horizontal-label-cell" data-index="${idx}" data-physical="${escapeHtml(pCol)}" data-logical="${escapeHtml(lCol)}" style="padding: 6px 12px; font-weight: bold; color: #000; border-right: 1px solid #ccc; text-align: center; white-space: nowrap;" title="${escapeHtml(middleLabel)}">${escapeHtml(middleLabel)}</th>`;

        previewHtml  += `<td style="padding: 6px 8px; border-right: 1px solid #ccc; font-size: 13px; color: #333; white-space: nowrap;">MultiInput_(${escapeHtml(currentTableName)})_(${escapeHtml(pCol)})</td>`;

        for (let r = 1; r <= rowCount; r++) {
            rowHtmls[r] += `<td class="horizontal-item-cell" data-index="${idx}" style="padding: 6px 8px; border-right: 1px solid #ccc; vertical-align: middle;">`;
            
            if (r === 1) {
                let current_style_val = existingStyles[pCol] || 'text';
                rowHtmls[r] += `<select class="multi-input-style-select" data-index="${idx}" data-row="${r}" data-physical="${escapeHtml(pCol)}" style="width: 140px; height: 28px; border: 1px solid #000; box-sizing: border-box; outline: none; font-size: 13px; cursor: pointer; background: #fff;" onchange="saveMainForm();">`;
                rowHtmls[r] += `<option value="" ${current_style_val === '' ? 'selected' : ''}>--</option>`;
                rowHtmls[r] += `<option value="text" ${current_style_val === 'text' ? 'selected' : ''}>text</option>`;
                rowHtmls[r] += `<option value="pulldown" ${current_style_val === 'pulldown' ? 'selected' : ''}>pulldown</option>`;
                rowHtmls[r] += `<option value="radiobutton" ${current_style_val === 'radiobutton' ? 'selected' : ''}>radiobutton</option>`;
                rowHtmls[r] += `<option value="checkbox" ${current_style_val === 'checkbox' ? 'selected' : ''}>checkbox</option>`;
                rowHtmls[r] += `<option value="button" ${current_style_val === 'button' ? 'selected' : ''}>button</option>`;
                rowHtmls[r] += `</select>`;
            } else {
                let val = existingCellValues[idx + '_' + r] || '';
                rowHtmls[r] += `<input type="text" class="multi-input-cell-value" data-index="${idx}" data-row="${r}" style="width: 140px; height: 26px; border: 1px solid #ccc; box-sizing: border-box; padding: 0 4px; font-size: 13px;" value="${escapeHtml(val)}" oninput="saveMainForm();">`;
            }
            
            rowHtmls[r] += `</td>`;
        }
    });

    checkboxHtml += '</tr>';
    headerHtml   += '</tr>';
    previewHtml  += '</tr>';
    for (let r = 1; r <= rowCount; r++) {
        rowHtmls[r] += '</tr>';
    }

    horizontalTable.innerHTML = checkboxHtml + headerHtml + previewHtml + Object.values(rowHtmls).join('');
}

function renderConfirmSection(columns, tableName) {
    const confirmTableBody = document.querySelector('#confirm-columns-table tbody');
    const displayLabelRadio = document.querySelector('input[name="display_label"]:checked');
    const isPhysical = displayLabelRadio ? displayLabelRadio.value === 'physical' : true;

    if (!confirmTableBody) return;

    let confirmHtml = '';
    columns.forEach((col) => {
        const pCol = col.physical_name || '';
        let lCol = col.logical_name || '';
        if (!lCol) { lCol = pCol; }
        const middleLabel = isPhysical ? pCol : lCol;

        confirmHtml += `
            <tr class="confirm-column-row" data-physical="${escapeHtml(pCol)}" data-logical="${escapeHtml(lCol)}" style="border-bottom: 1px solid #ccc;">
                <td style="text-align: center; border-right: 1px solid #ccc; padding: 8px; width: 50px; background-color: #fff;">
                    <input type="checkbox" name="confirm_columns[]" value="${escapeHtml(pCol)}" checked onchange="onConfirmCheckboxChange(this);" style="transform: scale(1.1); cursor: pointer;">
                </td>
                <td class="confirm-label-cell" data-physical="${escapeHtml(pCol)}" data-logical="${escapeHtml(lCol)}" style="padding: 8px 12px; border-right: 1px solid #ccc; text-align: left; width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="${escapeHtml(middleLabel)}">
                    ${escapeHtml(middleLabel)}
                </td>
                <td style="padding: 8px 12px; border-right: 1px solid #ccc; font-size: 13px; color: #333;">
                    MultiInput_(${escapeHtml(tableName)})_(${escapeHtml(pCol)})
                </td>
                <td style="padding: 8px 12px; width: 100px; text-align: center; font-size: 13px; color: #555;">
                    --
                </td>
            </tr>
        `;
    });
    confirmTableBody.innerHTML = confirmHtml;
}

function onConfirmCheckboxChange(checkbox) {
    const row = checkbox.closest('.confirm-column-row');
    const physical = row.getAttribute('data-physical');
    const horizontalTable = document.getElementById('horizontal-columns-table');
    if (!horizontalTable) return;

    const headerCells = horizontalTable.querySelectorAll('tr:nth-child(2) th:not(:first-child)');
    const checkboxCells = horizontalTable.querySelectorAll('tr:nth-child(1) td');

    headerCells.forEach((th, idx) => {
        if (th.getAttribute('data-physical') === physical) {
            const chkCell = checkboxCells[idx];
            if (chkCell) {
                const iCheckbox = chkCell.querySelector('input[type="checkbox"]');
                if (iCheckbox) {
                    iCheckbox.checked = checkbox.checked;
                }
            }
        }
    });

    toggleColumnListVisibility();
    saveMainForm();
}

function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/[&'`<>"]/g, function(match) {
        return { '&': '&amp;', "'": '&#x27;', '`': '&#x60;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[match];
    });
}

function updateSerializedData() {
    const table = document.getElementById('horizontal-columns-table');
    if (!table) return;

    const checkedColumns = [];
    const inputStyleMap = {};

    const rows = table.querySelectorAll('tr');
    if (rows.length < 4) return;

    const checkboxCells = rows[0].querySelectorAll('td');
    const headerCells = rows[1].querySelectorAll('th:not(:first-child)');
    const styleCells = rows[3].querySelectorAll('td'); // 4行目がスタイル選択行(r=1)

    headerCells.forEach((th, idx) => {
        const physicalName = th.getAttribute('data-physical');
        const chkCell = checkboxCells[idx];
        const styleCell = styleCells[idx];

        if (!physicalName) return;

        const checkbox = chkCell ? chkCell.querySelector('input[type="checkbox"]') : null;
        const styleSelect = styleCell ? styleCell.querySelector('select.multi-input-style-select') : null;

        if (checkbox && checkbox.checked) {
            checkedColumns.push(physicalName);
            inputStyleMap[physicalName] = styleSelect ? styleSelect.value : '';
        }
    });

    const checkedJsonEl = document.getElementById('checked_columns');
    if (checkedJsonEl) {
        checkedJsonEl.value = checkedColumns.join(',');
    }

    const inputStyleEl = document.getElementById('input_style_hidden');
    if (inputStyleEl) {
        inputStyleEl.value = JSON.stringify(inputStyleMap);
    }
}

function saveMainForm() {
    if (typeof updateSerializedData === 'function') {
        updateSerializedData();
    }
}

document.addEventListener('DOMContentLoaded', function() {
    toggleColumnListVisibility();
});
</script>
