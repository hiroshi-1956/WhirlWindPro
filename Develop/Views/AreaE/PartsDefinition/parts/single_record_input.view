                <div style="display: flex; align-items: center; width: 520px; height: 30px; border: 2px solid #000; background: #fff; box-sizing: border-box; padding: 0;">
                    <select id="table_name" style="width: 100%; height: 100%; border: none; background: transparent; padding: 0 6px; outline: none; font-size: 14px; cursor: pointer;" onchange="loadColumnsFromDB();">
