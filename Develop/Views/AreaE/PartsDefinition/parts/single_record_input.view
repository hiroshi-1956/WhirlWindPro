            <textarea id="error_message_box" style="width: 100%; height: 100%; border: none; outline: none; resize: none; font-size: 14px;" oninput="saveMainForm();"><?= htmlspecialchars($error_message ?? '', ENT_QUOTES, 'UTF-8') ?></textarea>
