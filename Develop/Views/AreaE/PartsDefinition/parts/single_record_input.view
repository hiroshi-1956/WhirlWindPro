                                    </select>
                                </td>
                                <td style="padding: 8px 12px; font-size: 13px; color: #333;">
                                    SingleInput_(<?= htmlspecialchars($current_table_name, ENT_QUOTES, 'UTF-8') ?>)_(<?= htmlspecialchars($p_col, ENT_QUOTES, 'UTF-8') ?>)
                                </td>
                            </tr>
                        <?php endforeach; ?>
                    <?php endif; ?>
                </tbody>
