        <div style="border: 2px solid #000; background: #fff; height: 90px; padding: 4px; box-sizing: border-box;">
            <textarea id="finish_message_box" style="width: 100%; height: 100%; border: none; outline: none; resize: none; font-size: 14px;" oninput="saveMainForm();"><?= htmlspecialchars($finish_message ?? '', ENT_QUOTES, 'UTF-8') ?></textarea>
        </div>
