<script>
let cachedColumnsData = null;

// 表示項目選択（物理名 / 日本語名）の連動
function switchDisplayLabel(type) {
    const labelCells = document.querySelectorAll('.vertical-label-cell, .confirm-label-cell');
    labelCells.forEach(td => {
        const physicalName = td.getAttribute('data-physical');
        const logicalName = td.getAttribute('data-logical');

        if (type === 'physical') {
            td.textContent = physicalName;
            td.setAttribute('title', physicalName);
        } else {
            const label = (logicalName && logicalName !== '&nbsp;') ? logicalName : physicalName;
            td.textContent = label;
            td.setAttribute('title', label);
        }
    });
}

// Input側でチェックボックスが変更された時の処理
function onInputCheckboxChange(checkbox) {
    const row = checkbox.closest('.vertical-column-row');
    const physical = row.getAttribute('data-physical');
    const styleSelect = row.querySelector('.single-input-style-select');

    if (!checkbox.checked) {
        if (styleSelect) {
            styleSelect.value = "";
        }
    } else {
        if (styleSelect && styleSelect.value === "") {
            styleSelect.value = "text";
        }
    }

    const confirmRows = document.querySelectorAll('.confirm-column-row');
    confirmRows.forEach(cRow => {
        if (cRow.getAttribute('data-physical') === physical) {
            const cCheckbox = cRow.querySelector('input[type="checkbox"]');
            if (cCheckbox) {
                cCheckbox.checked = checkbox.checked;
            }
        }
    });

    toggleColumnListVisibility();
    saveMainForm();
}

// Confirm側でチェックボックスが変更された時の処理
function onConfirmCheckboxChange(checkbox) {
    const row = checkbox.closest('.confirm-column-row');
    const physical = row.getAttribute('data-physical');

    const inputRows = document.querySelectorAll('.vertical-column-row');
    inputRows.forEach(iRow => {
        if (iRow.getAttribute('data-physical') === physical) {
            const iCheckbox = iRow.querySelector('input[type="checkbox"]');
            const styleSelect = iRow.querySelector('.single-input-style-select');
            if (iCheckbox) {
                iCheckbox.checked = checkbox.checked;
                if (!checkbox.checked && styleSelect) {
                    styleSelect.value = "";
                } else if (checkbox.checked && styleSelect && styleSelect.value === "") {
                    styleSelect.value = "text";
                }
            }
        }
    });

    toggleColumnListVisibility();
    saveMainForm();
}

// フィルタ（全カラム / 表示カラムだけ）によるInput側の表示/非表示制御
function toggleColumnListVisibility() {
    const filterRadio = document.querySelector('input[name="column_filter"]:checked');
    const filterType = filterRadio ? filterRadio.value : 'all';
    
    const inputRows = document.querySelectorAll('.vertical-column-row');
    inputRows.forEach(row => {
        const checkbox = row.querySelector('input[type="checkbox"]');
        if (!checkbox) return;

        let show = true;
        if (filterType === 'selected' && !checkbox.checked) {
            show = false;
        }
        row.style.display = show ? '' : 'none';
    });

    const confirmRows = document.querySelectorAll('.confirm-column-row');
    confirmRows.forEach(cRow => {
        cRow.style.display = '';
    });
}

function loadColumnsFromDB() {
    const tableSelect = document.getElementById('table_name');
    const selectedTableName = tableSelect.value;
    const verticalTableBody = document.querySelector('#vertical-columns-table tbody');
    const confirmTableBody = document.querySelector('#confirm-columns-table tbody');

    if (!selectedTableName) {
        if (verticalTableBody) verticalTableBody.innerHTML = '';
        if (confirmTableBody) confirmTableBody.innerHTML = '';
        cachedColumnsData = null;
        if (typeof saveMainForm === 'function') saveMainForm();
        return;
    }

    if (typeof window.bridge === 'function') {
        window.bridge({
            code: 'PartsDefinition/getColumns',
            table_name: selectedTableName,
            parts_type: document.getElementById('parts_type') ? document.getElementById('parts_type').value : 'Single Record Input',
            parts_id: document.getElementById('parts_id') ? document.getElementById('parts_id').value : '',
            preview_title: document.getElementById('preview_title') ? document.getElementById('preview_title').value : ''
        }, function(response) {
            if (response && response.columns) {
                cachedColumnsData = response.columns;
                renderSections(response.columns, selectedTableName);
                toggleColumnListVisibility();
                if (typeof saveMainForm === 'function') saveMainForm();
            }
        });
    }
}

function renderSections(columns, tableName) {
    const verticalTableBody = document.querySelector('#vertical-columns-table tbody');
    const confirmTableBody = document.querySelector('#confirm-columns-table tbody');
    const displayLabelRadio = document.querySelector('input[name="display_label"]:checked');
    const isPhysical = displayLabelRadio ? displayLabelRadio.value === 'physical' : true;

    if (!verticalTableBody || !confirmTableBody) return;

    let inputHtml = '';
    let confirmHtml = '';

    columns.forEach((col, idx) => {
        const pCol = col.physical_name || '';
        let lCol = col.logical_name || '';
        if (!lCol) { lCol = pCol; }
        const middleLabel = isPhysical ? pCol : lCol;

        inputHtml += `
            <tr class="vertical-column-row" data-physical="${escapeHtml(pCol)}" data-logical="${escapeHtml(lCol)}" style="border-bottom: 1px solid #ccc;">
                <td style="text-align: center; border-right: 1px solid #ccc; padding: 8px; width: 50px; background-color: #fff;">
                    <input type="checkbox" name="selected_columns_horizontal[]" value="${escapeHtml(pCol)}" data-index="${idx}" onchange="onInputCheckboxChange(this);" checked style="transform: scale(1.1); cursor: pointer;">
                </td>
                <td class="vertical-label-cell" data-physical="${escapeHtml(pCol)}" data-logical="${escapeHtml(lCol)}" style="padding: 8px 12px; border-right: 1px solid #ccc; text-align: left; width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="${escapeHtml(middleLabel)}">
                    ${escapeHtml(middleLabel)}
                </td>
                <td style="padding: 6px 8px; border-right: 1px solid #ccc; width: 160px; text-align: center;">
                    <select class="single-input-style-select" data-physical="${escapeHtml(pCol)}" style="width: 100%; height: 28px; border: 1px solid #000; box-sizing: border-box; outline: none; font-size: 13px; cursor: pointer; background: #fff;" onchange="saveMainForm();">
                        <option value="">--</option>
                        <option value="text" selected>text</option>
                        <option value="pulldown">pulldown</option>
                        <option value="radiobutton">radiobutton</option>
                        <option value="checkbox">checkbox</option>
                        <option value="button">button</option>
                    </select>
                </td>
                <td style="padding: 8px 12px; font-size: 13px; color: #333;">
                    SingleInput_(${escapeHtml(tableName)})_(${escapeHtml(pCol)})
                </td>
            </tr>
        `;

        confirmHtml += `
            <tr class="confirm-column-row" data-physical="${escapeHtml(pCol)}" data-logical="${escapeHtml(lCol)}" style="border-bottom: 1px solid #ccc;">
                <td style="text-align: center; border-right: 1px solid #ccc; padding: 8px; width: 50px; background-color: #fff;">
                    <input type="checkbox" name="confirm_columns[]" value="${escapeHtml(pCol)}" checked onchange="onConfirmCheckboxChange(this);" style="transform: scale(1.1); cursor: pointer;">
                </td>
                <td class="confirm-label-cell" data-physical="${escapeHtml(pCol)}" data-logical="${escapeHtml(lCol)}" style="padding: 8px 12px; border-right: 1px solid #ccc; text-align: left; width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="${escapeHtml(middleLabel)}">
                    ${escapeHtml(middleLabel)}
                </td>
                <td style="padding: 8px 12px; border-right: 1px solid #ccc; font-size: 13px; color: #333;">
                    SingleInput_(${escapeHtml(tableName)})_(${escapeHtml(pCol)})
                </td>
                <td style="padding: 8px 12px; width: 100px; text-align: center; font-size: 13px; color: #555;">
                    --
                </td>
            </tr>
        `;
    });

    verticalTableBody.innerHTML = inputHtml;
    confirmTableBody.innerHTML = confirmHtml;
}

function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/[&'`<>"]/g, function(match) {
        return { '&': '&amp;', "'": '&#x27;', '`': '&#x60;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[match];
    });
}

function updateSerializedData() {
    const rows = document.querySelectorAll('.vertical-column-row');
    const checkedColumns = [];
    const inputStyleMap = {};

    rows.forEach(row => {
        const checkbox = row.querySelector('input[type="checkbox"]');
        const styleSelect = row.querySelector('select.single-input-style-select');
        const physicalName = row.getAttribute('data-physical');

        if (!physicalName) return;

        if (checkbox && checkbox.checked) {
            checkedColumns.push(physicalName);
            inputStyleMap[physicalName] = styleSelect ? styleSelect.value : '';
        }
    });

    const checkedJsonEl = document.getElementById('checked_columns');
    if (checkedJsonEl) {
        checkedJsonEl.value = checkedColumns.join(',');
    }

    const inputStyleEl = document.getElementById('input_style_hidden');
    if (inputStyleEl) {
        inputStyleEl.value = JSON.stringify(inputStyleMap);
    }
}

function saveMainForm() {
    if (typeof updateSerializedData === 'function') {
        updateSerializedData();
    }
}

document.addEventListener('DOMContentLoaded', function() {
    toggleColumnListVisibility();
});
</script>