                                ?>
                                <option value="<?= htmlspecialchars($p_name, ENT_QUOTES, 'UTF-8') ?>" data-id="<?= htmlspecialchars($t_id, ENT_QUOTES, 'UTF-8') ?>" <?= $selected ?>>
                                    <?= htmlspecialchars($display_text, ENT_QUOTES, 'UTF-8') ?>
                                </option>
                            <?php endforeach; ?>
                        <?php endif; ?>
                    </select>
