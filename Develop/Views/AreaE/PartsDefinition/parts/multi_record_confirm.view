                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                        <input type="radio" name="display_label" value="physical" <?= $current_display === 'physical' ? 'checked' : '' ?> onchange="switchDisplayLabel('physical'); saveMainForm();"> 物理名
                    </label>
                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
