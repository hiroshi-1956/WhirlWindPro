            <td style="padding: 0; vertical-align: middle;">
                <div id="wrapper-multi-rows" style="display: flex; align-items: center; gap: 8px; padding-left: 0;">
                    <input type="number" id="input_rows" name="input_rows" min="1" max="99" style="width: 60px; height: 30px; border: 2px solid #000; padding: 0 6px; background: #fff; box-sizing: border-box; outline: none; font-size: 14px; font-weight: bold; text-align: center;" value="<?= htmlspecialchars($input_rows ?? '3', ENT_QUOTES, 'UTF-8'); ?>" oninput="onRowCountChange(); saveMainForm();" onchange="onRowCountChange(); saveMainForm();">
                    <span style="font-size: 14px; font-weight: bold; color: #000;">行</span>
                </div>
            </td>
