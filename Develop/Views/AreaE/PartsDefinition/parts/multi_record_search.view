    <!-- 横書き専用のテーブル表示エリア -->
    <div id="column-list-wrapper" style="display: <?= !empty($table_name) ? 'block' : 'none'; ?>; margin-top: 15px; margin-left: 120px; width: max-content; box-sizing: border-box;">		            
        <div id="container-layout-horizontal" style="width: max-content; overflow-x: auto; border: 2px solid #000; background-color: #fff; box-sizing: border-box;">
            <table id="horizontal-columns-table" style="border-collapse: collapse; width: auto; font-size: 14px; background-color: #fff; table-layout: auto;">
                <?php if (!empty($m_partsinfo_columns)): ?>
                    <?php 
                        $showDetail = ($current_detail === 'exist');
                        
                        $decoded_input_style = [];
                        if (isset($input_style)) {
                            if (is_array($input_style)) {
                                $decoded_input_style = $input_style;
                            } else if (is_string($input_style)) {
                                $decoded_input_style = json_decode($input_style, true) ?? [];
                            }
                        }

                        $checkboxHtml = '<tr style="border-bottom: 1px solid #ccc; background-color: #fafafa;"><th style="width: 60px; padding: 6px 8px; font-weight: bold; color: #000; border-right: 1px solid #ccc; text-align: center; white-space: nowrap; background-color: #fafafa;">選択</th>';
                        $pulldownHtml = '<tr style="border-bottom: 1px solid #ccc; background-color: #fff;"><th style="width: 60px; padding: 6px 8px; font-weight: bold; color: #000; border-right: 1px solid #ccc; text-align: center; white-space: nowrap; background-color: #fafafa;">検索</th>';
                        $headerHtml   = '<tr style="border-bottom: 1px solid #ccc;"><th style="width: 60px; padding: 6px 8px; font-weight: bold; color: #000; border-right: 1px solid #ccc; text-align: center; white-space: nowrap; background-color: #fafafa;">項目名</th>';
                        
                        $rowHtmls = [];
                        for ($r = 1; $r <= $rowCount; $r++) {
                            $rowHtmls[$r] = '<tr><th style="width: 60px; padding: 6px 8px; font-weight: bold; color: #000; border-right: 1px solid #ccc; text-align: center; white-space: nowrap; background-color: #fafafa;">' . $r . '</th>';
                        }

                        foreach ($m_partsinfo_columns as $idx => $col) {
                            $p_col = $col['physical_name'] ?? ''; 
                            $l_col = $col['logical_name'] ?? ''; 
                            if (empty($l_col) || $l_col === '&nbsp;') { $l_col = $p_col; }
                            $middle_label = ($current_display === 'physical') ? $p_col : $l_col;

                            $isChecked = false;
                            if (empty($is_edit)) {
                                $isChecked = true;
                            } else if (!empty($checked_columns) && is_array($checked_columns)) {
                                $lower_checked = array_map('strtolower', $checked_columns);
                                if (in_array(strtolower($p_col), $lower_checked)) {
                                    $isChecked = true;
                                }
                            }

                            $current_pulldown_val = $decoded_input_style[$p_col] ?? '';

                            $checkboxHtml .= '<td class="horizontal-item-cell" data-index="'.$idx.'" style="text-align: center; border-right: 1px solid #ccc; padding: 6px 8px; background-color: #fff;">';
                            $checkboxHtml .= '<input type="checkbox" name="selected_columns_horizontal[]" value="'.htmlspecialchars($p_col, ENT_QUOTES, 'UTF-8').'" data-index="'.$idx.'" onchange="toggleColumnListVisibility(); saveMainForm();" '.($isChecked ? 'checked' : '').' style="transform: scale(1.1); cursor: pointer;">';
                            $checkboxHtml .= '</td>';

                            $pulldownHtml .= '<td class="horizontal-pulldown-cell" data-index="'.$idx.'" data-physical="'.htmlspecialchars($p_col, ENT_QUOTES, 'UTF-8').'" style="text-align: center; border-right: 1px solid #ccc; padding: 4px 6px; background-color: #fff;">';
                            $pulldownHtml .= '<select name="column_pulldown['.htmlspecialchars($p_col, ENT_QUOTES, 'UTF-8').']" class="column-pulldown-select" style="height: 24px; font-size: 12px; border: 1px solid #999; outline: none; background: #fff; cursor: pointer;" onchange="saveMainForm();">';
                            $pulldownHtml .= '<option value="">-- 選択してください --</option>';
                            $pulldownHtml .= '<option value="text" '.($current_pulldown_val === 'text' ? 'selected' : '').'>text</option>';
                            $pulldownHtml .= '<option value="pulldown" '.($current_pulldown_val === 'pulldown' ? 'selected' : '').'>pulldown</option>';
                            $pulldownHtml .= '<option value="radiobox" '.($current_pulldown_val === 'radiobox' ? 'selected' : '').'>radiobox</option>';
                            $pulldownHtml .= '<option value="checkbox" '.($current_pulldown_val === 'checkbox' ? 'selected' : '').'>checkbox</option>';
                            $pulldownHtml .= '</select>';
                            $pulldownHtml .= '</td>';

                            $headerHtml   .= '<th class="horizontal-label-cell" data-index="'.$idx.'" data-physical="'.htmlspecialchars($p_col, ENT_QUOTES, 'UTF-8').'" data-logical="'.htmlspecialchars($l_col, ENT_QUOTES, 'UTF-8').'" style="padding: 6px 12px; font-weight: bold; color: #000; border-right: 1px solid #ccc; text-align: center; white-space: nowrap;" title="'.htmlspecialchars($middle_label, ENT_QUOTES, 'UTF-8').'">'.htmlspecialchars($middle_label, ENT_QUOTES, 'UTF-8').'</th>';

                            for ($r = 1; $r <= $rowCount; $r++) {
                                $rowHtmls[$r] .= '<td class="horizontal-item-cell" data-index="'.$idx.'" style="width: 140px; height: 28px; padding: 6px 8px; border-right: 1px solid #ccc; border-bottom: 1px solid #ccc; background-color: #fff; vertical-align: middle;">&nbsp;</td>';
                            }
                        }
                        
                        $displayStyleDetail = $showDetail ? '' : 'display: none;';

                        $checkboxHtml .= '<td style="background-color: #fafafa; border-left: 1px solid #ccc; padding: 0;">&nbsp;</td>';
                        $pulldownHtml .= '<td style="background-color: #fff; border-left: 1px solid #ccc; padding: 4px 8px; vertical-align: middle; text-align: center;"><div style="width: 60px; height: 28px; display: inline-flex; align-items: center; justify-content: center; background-color: #28a745; color: #fff; border: 1px solid #1e7e34; font-size: 12px; font-weight: bold; box-sizing: border-box; cursor: pointer;" onclick="alert(\'検索を実行します\');">検索</div></td>';
                        $headerHtml   .= '<td style="background-color: #fafafa; border-left: 1px solid #ccc; padding: 0;">&nbsp;</td>';
                        
                        for ($r = 1; $r <= $rowCount; $r++) {
                            $rowHtmls[$r] .= '<td class="detail-button-cell" style="background-color: #fff; border-left: 1px solid #ccc; border-bottom: 1px solid #ccc; padding: 4px 8px; vertical-align: middle; text-align: center; ' . $displayStyleDetail . '"><div style="width: 60px; height: 28px; display: inline-flex; align-items: center; justify-content: center; background-color: #007bff; color: #fff; border: 1px solid #0056b3; font-size: 12px; font-weight: bold; box-sizing: border-box; cursor: pointer;" onclick="alert(\'行 '.$r.' の詳細を表示します\');">詳細</div></td>';
                        }

                        $checkboxHtml .= '</tr>';
                        $pulldownHtml .= '</tr>';
                        $headerHtml   .= '</tr>';
                        foreach ($rowHtmls as $r => $rH) {
                            $rowHtmls[$r] .= '</tr>';
                        }

                        echo $checkboxHtml . $pulldownHtml . $headerHtml . implode('', $rowHtmls);
                    ?>
                <?php endif; ?>
            </table>
        </div>
    </div>
</div>

<script>
let cachedColumnsData = null;
const FIXED_ROW_COUNT = 3;

function switchDisplayLabel(type) {
    const headers = document.querySelectorAll('.horizontal-label-cell');
    headers.forEach(th => {
        const physicalName = th.getAttribute('data-physical');
        const logicalName = th.getAttribute('data-logical');

        if (type === 'physical') {
            th.textContent = physicalName;
            th.setAttribute('title', physicalName);
        } else {
            const label = (logicalName && logicalName !== '&nbsp;') ? logicalName : physicalName;
            th.textContent = label;
            th.setAttribute('title', label);
        }
    });
}

function toggleDetailButtonVisibility() {
    const detailButtonRadio = document.querySelector('input[name="detail_button"]:checked');
    const isExist = detailButtonRadio && detailButtonRadio.value === 'exist';
    
    const detailCells = document.querySelectorAll('.detail-button-cell');
    detailCells.forEach(cell => {
        cell.style.display = isExist ? '' : 'none';
    });
    
    saveMainForm();
}

function toggleColumnListVisibility() {
    const filterRadio = document.querySelector('input[name="column_filter"]:checked');
    const filterType = filterRadio ? filterRadio.value : 'all';
    
    const table = document.getElementById('horizontal-columns-table');
    if (!table || table.rows.length < 3) return;

    const checkboxCells = table.querySelectorAll('tr:nth-child(1) td');
    const pulldownCells = table.querySelectorAll('tr:nth-child(2) td');
    const headerCells = table.querySelectorAll('tr:nth-child(3) th:not(:first-child)');
    const allRows = table.querySelectorAll('tr');

    headerCells.forEach((th, idx) => {
        const chkCell = checkboxCells[idx];
        const pdCell = pulldownCells[idx];
        if (!chkCell) return;

        const checkbox = chkCell.querySelector('input[type="checkbox"]');
        if (!checkbox) return;

        let show = true;
        if (filterType === 'selected' && !checkbox.checked) {
            show = false;
        }

        const displayStyle = show ? '' : 'none';
        th.style.display = displayStyle;
        chkCell.style.display = displayStyle;
        if (pdCell) pdCell.style.display = displayStyle;

        for (let r = 3; r < allRows.length; r++) {
            const rowCells = allRows[r].querySelectorAll('td');
            if (rowCells[idx] && !rowCells[idx].classList.contains('detail-button-cell')) {
                rowCells[idx].style.display = displayStyle;
            }
        }
    });
}

function loadColumnsFromDB() {
    const tableSelect = document.getElementById('table_name');
    const selectedTableName = tableSelect ? tableSelect.value : '';
    const columnListWrapper = document.getElementById('column-list-wrapper');
    const horizontalTable = document.getElementById('horizontal-columns-table');

    if (!selectedTableName) {
        if (columnListWrapper) columnListWrapper.style.display = 'none';
        if (horizontalTable) horizontalTable.innerHTML = '';
        cachedColumnsData = null;
        if (typeof saveMainForm === 'function') saveMainForm();
        return;
    }

    const detailButtonRadio = document.querySelector('input[name="detail_button"]:checked');
    const detailButtonVal = detailButtonRadio ? detailButtonRadio.value : 'none';

    if (typeof window.bridge === 'function') {
        window.bridge({
            code: 'PartsDefinition/getColumns',
            table_name: selectedTableName,
            parts_type: document.getElementById('parts_type') ? document.getElementById('parts_type').value : 'Multi Record Search',
            parts_id: document.getElementById('parts_id') ? document.getElementById('parts_id').value : '',
            parts_name: document.getElementById('parts_name') ? document.getElementById('parts_name').value : '',
            parts_description: document.getElementById('parts_description') ? document.getElementById('parts_description').value : '',
            preview_title: document.getElementById('preview_title') ? document.getElementById('preview_title').value : '',
            detail_button: detailButtonVal,
            input_rows: FIXED_ROW_COUNT
        }, function(response) {
            if (response && response.columns) {
                cachedColumnsData = response.columns;
                renderHorizontalColumns(response.columns);
                if (columnListWrapper) columnListWrapper.style.display = 'block';
                toggleColumnListVisibility();
                toggleDetailButtonVisibility();
                if (typeof saveMainForm === 'function') saveMainForm();
            }
        });
    }
}

function renderHorizontalColumns(columns) {
    const horizontalTable = document.getElementById('horizontal-columns-table');
    const displayLabelRadio = document.querySelector('input[name="display_label"]:checked');
    const isPhysical = displayLabelRadio ? displayLabelRadio.value === 'physical' : true;
    const detailButtonRadio = document.querySelector('input[name="detail_button"]:checked');
    const showDetail = detailButtonRadio ? (detailButtonRadio.value === 'exist') : false;
    const rowCount = FIXED_ROW_COUNT;

    const existingCheckboxes = {};
    const existingPulldowns = {};

    if (horizontalTable && horizontalTable.rows.length >= 2) {
        const oldCheckCells = horizontalTable.querySelectorAll('tr:nth-child(1) td');
        const oldPulldownCells = horizontalTable.querySelectorAll('tr:nth-child(2) td');
        
        oldCheckCells.forEach((chkCell, idx) => {
            const chk = chkCell.querySelector('input[type="checkbox"]');
            if (chk) {
                existingCheckboxes[chk.value] = chk.checked;
            }
            if (oldPulldownCells[idx]) {
                const sel = oldPulldownCells[idx].querySelector('select');
                const physicalName = oldPulldownCells[idx].getAttribute('data-physical');
                if (sel && physicalName) {
                    existingPulldowns[physicalName] = sel.value;
                }
            }
        });
    }

    let checkboxHtml = '<tr style="border-bottom: 1px solid #ccc; background-color: #fafafa;"><th style="width: 60px; padding: 6px 8px; font-weight: bold; color: #000; border-right: 1px solid #ccc; text-align: center; white-space: nowrap; background-color: #fafafa;">選択</th>';
    let pulldownHtml = '<tr style="border-bottom: 1px solid #ccc; background-color: #fff;"><th style="width: 60px; padding: 6px 8px; font-weight: bold; color: #000; border-right: 1px solid #ccc; text-align: center; white-space: nowrap; background-color: #fafafa;">検索</th>';
    let headerHtml   = '<tr style="border-bottom: 1px solid #ccc;"><th style="width: 60px; padding: 6px 8px; font-weight: bold; color: #000; border-right: 1px solid #ccc; text-align: center; white-space: nowrap; background-color: #fafafa;">項目名</th>';
    
    let rowHtmls = {};
    for (let r = 1; r <= rowCount; r++) {
        rowHtmls[r] = `<tr><th style="width: 60px; padding: 6px 8px; font-weight: bold; color: #000; border-right: 1px solid #ccc; text-align: center; white-space: nowrap; background-color: #fafafa;">${r}</th>`;
    }

    columns.forEach((col, idx) => {
        const pCol = col.physical_name || '';
        let lCol = col.logical_name || '';
        if (!lCol) { lCol = pCol; }
        const middleLabel = isPhysical ? pCol : lCol;

        let isChecked = true;
        if (existingCheckboxes.hasOwnProperty(pCol)) {
            isChecked = existingCheckboxes[pCol];
        }

        const currentPdVal = existingPulldowns[pCol] || '';

        checkboxHtml += `<td class="horizontal-item-cell" data-index="${idx}" style="text-align: center; border-right: 1px solid #ccc; padding: 6px 8px; background-color: #fff;">`;
        checkboxHtml += `<input type="checkbox" name="selected_columns_horizontal[]" value="${escapeHtml(pCol)}" data-index="${idx}" onchange="toggleColumnListVisibility(); saveMainForm();" ${isChecked ? 'checked' : ''} style="transform: scale(1.1); cursor: pointer;">`;
        checkboxHtml += `</td>`;

        pulldownHtml += `<td class="horizontal-pulldown-cell" data-index="${idx}" data-physical="${escapeHtml(pCol)}" style="text-align: center; border-right: 1px solid #ccc; padding: 4px 6px; background-color: #fff;">`;
        pulldownHtml += `<select name="column_pulldown[${escapeHtml(pCol)}]" class="column-pulldown-select" style="height: 24px; font-size: 12px; border: 1px solid #999; outline: none; background: #fff; cursor: pointer;" onchange="saveMainForm();">`;
        pulldownHtml += `<option value="">-- 選択してください --</option>`;
        pulldownHtml += `<option value="text" ${currentPdVal === 'text' ? 'selected' : ''}>text</option>`;
        pulldownHtml += `<option value="pulldown" ${currentPdVal === 'pulldown' ? 'selected' : ''}>pulldown</option>`;
        pulldownHtml += `<option value="radiobox" ${currentPdVal === 'radiobox' ? 'selected' : ''}>radiobox</option>`;
        pulldownHtml += `<option value="checkbox" ${currentPdVal === 'checkbox' ? 'selected' : ''}>checkbox</option>`;
        pulldownHtml += `</select>`;
        pulldownHtml += `</td>`;

        headerHtml   += `<th class="horizontal-label-cell" data-index="${idx}" data-physical="${escapeHtml(pCol)}" data-logical="${escapeHtml(lCol)}" style="padding: 6px 12px; font-weight: bold; color: #000; border-right: 1px solid #ccc; text-align: center; white-space: nowrap;" title="${escapeHtml(middleLabel)}">${escapeHtml(middleLabel)}</th>`;

        for (let r = 1; r <= rowCount; r++) {
            rowHtmls[r] += `<td class="horizontal-item-cell" data-index="${idx}" style="width: 140px; height: 28px; padding: 6px 8px; border-right: 1px solid #ccc; border-bottom: 1px solid #ccc; background-color: #fff; vertical-align: middle;">&nbsp;</td>`;
        }
    });

    const displayStyleDetail = showDetail ? '' : 'display: none;';

    checkboxHtml += '<td style="background-color: #fafafa; border-left: 1px solid #ccc; padding: 0;">&nbsp;</td>';
    pulldownHtml += '<td style="background-color: #fff; border-left: 1px solid #ccc; padding: 4px 8px; vertical-align: middle; text-align: center;"><div style="width: 60px; height: 28px; display: inline-flex; align-items: center; justify-content: center; background-color: #28a745; color: #fff; border: 1px solid #1e7e34; font-size: 12px; font-weight: bold; box-sizing: border-box; cursor: pointer;" onclick="alert(\'検索を実行します\');">検索</div></td>';
    headerHtml   += '<td style="background-color: #fafafa; border-left: 1px solid #ccc; padding: 0;">&nbsp;</td>';
    
    for (let r = 1; r <= rowCount; r++) {
        rowHtmls[r] += `<td class="detail-button-cell" style="background-color: #fff; border-left: 1px solid #ccc; border-bottom: 1px solid #ccc; padding: 4px 8px; vertical-align: middle; text-align: center; ${displayStyleDetail}"><div style="width: 60px; height: 28px; display: inline-flex; align-items: center; justify-content: center; background-color: #007bff; color: #fff; border: 1px solid #0056b3; font-size: 12px; font-weight: bold; box-sizing: border-box; cursor: pointer;" onclick="alert('行 ${r} の詳細を表示します');">詳細</div></td>`;
    }

    checkboxHtml += '</tr>';
    pulldownHtml += '</tr>';
    headerHtml   += '</tr>';
    for (let r = 1; r <= rowCount; r++) {
        rowHtmls[r] += '</tr>';
    }

    if (horizontalTable) {
        horizontalTable.innerHTML = checkboxHtml + pulldownHtml + headerHtml + Object.values(rowHtmls).join('');
    }
}

function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/[&'`<>"]/g, function(match) {
        return {
            '&': '&amp;',
            "'": '&#x27;',
            '`': '&#x60;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;'
        }[match];
    });
}

document.addEventListener('DOMContentLoaded', function() {
    const isEditMode = document.getElementById('is_edit_mode_flag') && document.getElementById('is_edit_mode_flag').value === '1';

    if (isEditMode) {
        const partsTypeEl = document.getElementById('parts_type') || document.querySelector('[name="parts_type"]');
        if (partsTypeEl && partsTypeEl.tagName === 'SELECT') {
            partsTypeEl.disabled = true;
            partsTypeEl.style.backgroundColor = '#f0f0f0';
            partsTypeEl.style.cursor = 'not-allowed';
        }
    }

    const horizontalTable = document.getElementById('horizontal-columns-table');
    if (horizontalTable && horizontalTable.children.length > 0) {
        const headerCells = horizontalTable.querySelectorAll('tr:nth-child(3) th:not(:first-child)');
        if (headerCells.length > 0) {
            cachedColumnsData = [];
            headerCells.forEach(th => {
                cachedColumnsData.push({
                    physical_name: th.getAttribute('data-physical'),
                    logical_name: th.getAttribute('data-logical')
                });
            });
        }
    }

    toggleColumnListVisibility();
    toggleDetailButtonVisibility();
});

function updateSerializedData() {
    const table = document.getElementById('horizontal-columns-table');
    if (!table || table.rows.length < 3) return;

    const checkedColumns = [];
    const inputStyleData = {};
    const rows = table.querySelectorAll('tr');
    if (rows.length < 3) return;

    const checkboxCells = rows[0].querySelectorAll('td');
    const pulldownCells = rows[1].querySelectorAll('td');
    const headerCells = rows[2].querySelectorAll('th:not(:first-child)');

    headerCells.forEach((th, idx) => {
        const physicalName = th.getAttribute('data-physical');
        const chkCell = checkboxCells[idx];
        const pdCell = pulldownCells[idx];

        if (!physicalName) return;

        const checkbox = chkCell ? chkCell.querySelector('input[type="checkbox"]') : null;
        if (checkbox && checkbox.checked) {
            checkedColumns.push(physicalName);
        }

        if (pdCell) {
            const selectEl = pdCell.querySelector('select');
            if (selectEl && selectEl.value) {
                inputStyleData[physicalName] = selectEl.value;
            }
        }
    });

    const checkedJsonEl = document.getElementById('checked_columns');
    if (checkedJsonEl) {
        checkedJsonEl.value = checkedColumns.join(',');
    }

    let inputStyleEl = document.getElementById('input_style_json');
    if (!inputStyleEl) {
        inputStyleEl = document.createElement('input');
        inputStyleEl.type = 'hidden';
        inputStyleEl.id = 'input_style_json';
        inputStyleEl.name = 'input_style';
        document.getElementById('search-multi-record-fields-container').appendChild(inputStyleEl);
    } else {
        inputStyleEl.name = 'input_style';
    }
    inputStyleEl.value = JSON.stringify(inputStyleData);

    // ★詳細ボタンの選択状態を隠しフィールド（detail_button_hidden）へ確実に同期する
    const detailButtonRadio = document.querySelector('input[name="detail_button"]:checked');
    if (detailButtonRadio) {
        let detailHiddenEl = document.getElementById('detail_button_hidden');
        if (!detailHiddenEl) {
            detailHiddenEl = document.createElement('input');
            detailHiddenEl.type = 'hidden';
            detailHiddenEl.id = 'detail_button_hidden';
            detailHiddenEl.name = 'detail_button';
            document.getElementById('search-multi-record-fields-container').appendChild(detailHiddenEl);
        }
        detailHiddenEl.value = detailButtonRadio.value;
    }

    // ★ search_area に無条件で 1 をセットする隠しフィールドの同期処理
    let searchAreaEl = document.getElementById('search_area_hidden');
    if (!searchAreaEl) {
        searchAreaEl = document.createElement('input');
        searchAreaEl.type = 'hidden';
        searchAreaEl.id = 'search_area_hidden';
        searchAreaEl.name = 'search_area';
        const container = document.getElementById('search-multi-record-fields-container') || document.getElementById('module-container');
        if (container) {
            container.appendChild(searchAreaEl);
        }
    }
    searchAreaEl.value = '1';
}
</script>