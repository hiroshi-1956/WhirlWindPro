<div class="designer-base" style="padding: 20px; box-sizing: border-box; background-color: transparent; font-family: 'Helvetica Neue', Arial, sans-serif; font-size: 13px;">
    <div class="title" style="font-size: 14px; font-weight: bold; margin-bottom: 25px; border-bottom: 1px solid #ccc; padding-bottom: 10px;">
	    画面パーツ修正
	</div>

    <input type="hidden" id="parts_id" value="<?= htmlspecialchars($parts_id ?? '', ENT_QUOTES, 'UTF-8') ?>">
	<input type="hidden" id="is_edit_mode_flag" value="1">
    <input type="hidden" id="grids_config_json" name="grids_config_json" value="">

    <table class="input-table" style="border-collapse: collapse; margin-bottom: 30px; width: 100%;">
        <tr>
            <th style="width: 130px; text-align: left; font-weight: normal; font-size: 13px; padding: 10px 5px;">画面パーツ名称</th>
            <td><input type="text" id="parts_name" class="simple-input" style="width: 450px; border: 1px solid #000; padding: 6px; background: #fff; outline: none; font-size: 13px;" value="<?= htmlspecialchars($parts_name ?? '', ENT_QUOTES, 'UTF-8') ?>"></td>
        </tr>
        <tr>
            <th style="width: 130px; text-align: left; font-weight: normal; font-size: 13px; padding: 10px 5px;">内容の説明</th>
            <td><input type="text" id="parts_description" class="simple-input" style="width: 90%; border: 1px solid #000; padding: 6px; background: #fff; outline: none; font-size: 13px;" value="<?= htmlspecialchars($parts_description ?? '', ENT_QUOTES, 'UTF-8') ?>"></td>
        </tr>
    </table>

    <div class="config-row" style="display: flex; align-items: center; gap: 15px; margin: 30px 0; font-size: 13px;">
        <span>サイズ</span>
        <select id="rows" class="size-select" style="border: 1px solid #000; padding: 4px; font-weight: bold; font-size: 14px; background: #fff; width: 60px;" onchange="saveMainForm(); rebuildGrid();">
            <?php for($i=1; $i<=6; $i++): ?>
                <option value="<?= $i ?>" <?= (isset($rows) && $rows == $i) ? 'selected' : ($i==1 ? 'selected' : '') ?>><?= $i ?></option>
            <?php endfor; ?>
        </select>
        <span>×</span>
        <select id="cols" class="size-select" style="border: 1px solid #000; padding: 4px; font-weight: bold; font-size: 14px; background: #fff; width: 60px;" onchange="saveMainForm(); rebuildGrid();">
            <?php for($j=1; $j<=3; $j++): ?>
                <option value="<?= $j ?>" <?= (isset($cols) && $cols == $j) ? 'selected' : ($j==1 ? 'selected' : '') ?>><?= $j ?></option>
            <?php endfor; ?>
        </select>
        
        <button type="button" class="btn-decision" style="background-color: #ffccbc; color: #d84315; border: 1px solid #d84315; padding: 6px 25px; border-radius: 4px; cursor: pointer; font-weight: bold; font-size: 12px;" onclick="saveMainForm(); rebuildGrid();">決定</button>
    </div>

    <div id="preview-grid" style="display: grid; gap: 15px; width: 100%; max-width: 1200px; margin-top: 20px; margin-bottom: 10px; grid-template-columns: repeat(1, 1fr);">
    </div>

    <div class="action-footer" style="display: flex; justify-content: space-between; align-items: center; margin-top: 20px; padding: 20px 0;">
        <button type="button" class="btn-image" style="background-color: #607d8b; color: white; border: none; padding: 10px 25px; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 12px;" onclick="sendToImageAction();">画面イメージ</button>

        <div class="footer-right" style="display: flex; gap: 20px;">
            <button type="button" class="btn-cancel" style="background-color: #ff0000; color: white; border: none; padding: 10px 30px; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 12px;" onclick="if(confirm('入力内容は破棄されます。キャンセルしてもよろしいですか？')){ clearMainFormBackup(); bridge({ code: 'PartsDefinition/cancel' }); }">キャンセル</button>
            <button type="button" class="btn-register" style="background-color: #5d8b41; color: white; border: none; padding: 10px 40px; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 12px;" onclick="sendToRegisterAction();">登録</button>
        </div>
    </div>
</div>

<script>
if (typeof bridge === 'undefined' && typeof parent !== 'undefined' && typeof parent.bridge === 'function') {
    var bridge = parent.bridge;
}

// 💡 詳細設定画面の保存先キー名と完全に一致
const STORAGE_KEY_MAIN_FORM = 'wwProject_main_form_backup';

/**
 * 初期データ展開・同期ロジック
 */
function initEditData() {
    var editConfigJson = '<?= !empty($grids_config_json) ? $grids_config_json : "{}" ?>';
    
    try {
        var gridsConfig = JSON.parse(editConfigJson);
        var formData = {
            parts_name: '<?= htmlspecialchars($parts_name ?? '', ENT_QUOTES, "UTF-8") ?>',
            parts_description: '<?= htmlspecialchars($parts_description ?? '', ENT_QUOTES, "UTF-8") ?>',
            rows: '<?= htmlspecialchars($rows_count ?? $rows ?? "1", ENT_QUOTES, "UTF-8") ?>',
            cols: '<?= htmlspecialchars($cols_count ?? $cols ?? "1", ENT_QUOTES, "UTF-8") ?>',
            grids_config: gridsConfig
        };
        sessionStorage.setItem(STORAGE_KEY_MAIN_FORM, JSON.stringify(formData));
    } catch(e) {
        console.error("データの同期に失敗しました", e);
    }
}

/**
 * グリッド枠の再構築
 */
function rebuildGrid() {
    var rowsEl = document.getElementById('rows');
    var colsEl = document.getElementById('cols');
    if (!rowsEl || !colsEl) return;

    var rows = parseInt(rowsEl.value) || 1;
    var cols = parseInt(colsEl.value) || 1;
    var grid = document.getElementById('preview-grid');
    if (!grid) return;

    // 現在選択されている種別（プルダウン）の値を退避
    var savedValues = {};
    document.querySelectorAll('.tile-item').forEach(function(item) {
        var pos = item.getAttribute('data-pos');
        var mainSel = item.querySelector('.tile-main-select');
        if (pos && mainSel) {
            savedValues[pos] = { main: mainSel.value };
        }
    });

    // セッションストレージから詳細データをロード
    var sessionData = sessionStorage.getItem(STORAGE_KEY_MAIN_FORM);
    var gridsConfig = {};
    if (sessionData) {
        try {
            var parsed = JSON.parse(sessionData);
            gridsConfig = parsed.grids_config || {};
        } catch(e) {}
    }
    
    grid.style.gridTemplateColumns = 'repeat(' + cols + ', 1fr)';
    var html = '';
    
    var options = [
        { value: '', text: '--' },
        { value: 'Single Record 入力', text: 'Single Record 入力' },
        { value: 'Multi Record 入力', text: 'Multi Record 入力' },
        { value: 'Single Record 表示', text: 'Single Record 表示' },
        { value: 'Multi Record 表示', text: 'Multi Record 表示' },
        { value: 'テキスト表示', text: 'テキスト表示' }
    ];
    
    for (var r = 1; r <= rows; r++) {
        for (var c = 1; c <= cols; c++) {
            var posLabel = '[' + r + ',' + c + ']';
            
            var prevMain = '';
            if (savedValues[posLabel] && savedValues[posLabel].main !== '') {
                prevMain = savedValues[posLabel].main;
            } else if (gridsConfig[posLabel]) {
                prevMain = gridsConfig[posLabel].layout_type || '';
            }
            
            var config = gridsConfig[posLabel];
            var isRegistered = false;
            if (config && (config.table_id || config.table_name_text || config.preview_title)) {
                isRegistered = true;
            }
            
            var btnColor = isRegistered ? '#e53935' : '#757575'; 

            html += '<div class="tile-item" data-pos="' + posLabel + '" style="display: flex; flex-direction: column;">';
            html += '  <div class="tile-label" style="font-size: 11px; margin-bottom: 6px; color: #333; font-weight: bold;">' + posLabel + '</div>';
            html += '  <div class="tile-box" style="border: 1px solid #000; background-color: #fff; box-sizing: border-box; width: 100%; min-height: 125px; display: flex; flex-direction: column; justify-content: flex-start; align-items: center; gap: 6px; margin-bottom: 10px; position: relative; padding: 24px 10px 10px 10px;">';
            
            html += '    <button type="button" class="btn-expand" style="position: absolute; top: 4px; right: 4px; width: 18px; height: 18px; background-color: ' + btnColor + '; color: #fff; border: none; border-radius: 2px; font-size: 10px; display: flex; align-items: center; justify-content: center; cursor: pointer; padding: 0;" onclick="handleExpand(' + r + ', ' + c + ');">↗</button>';
            
            html += '    <select class="tile-main-select" style="width: 95%; padding: 4px; border: 1px solid #ccc; font-size: 11px;" onchange="saveMainForm(); rebuildGrid();">';
            options.forEach(function(opt) {
                var selected = (opt.value === prevMain) ? 'selected' : '';
                html += '      <option value="' + opt.value + '" ' + selected + '>' + opt.text + '</option>';
            });
            html += '    </select>';
            
            if (config && (config.table_id || config.table_name_text || config.preview_title)) {
                var tblMark = config.table_name_text ? '📁 ' + config.table_name_text : (config.table_id ? '📁 ID: ' + config.table_id : '📁 --');
                var lblMark = '📋 テーブルカラム：' + (config.display_label === 'logical' ? '論理名' : '物理名');
                var ttlMark = '📝 表題: ' + (config.preview_title ? config.preview_title : '--');
                var ttlDisp = config.preview_title ? '📝 ' + (config.preview_title.length > 12 ? config.preview_title.substring(0,12)+'…' : config.preview_title) : '📝 --';
                var fltMark = config.column_filter === 'selected' ? '🔍 表示のみ' : '🔍 全表示';
                
                html += '    <div class="tile-meta-zone" style="width: 95%; display: flex; flex-direction: column; gap: 3px; margin-top: 4px; border-top: 1px dashed #ddd; padding-top: 5px; font-size: 9px; color: #444; text-align: left; line-height: 1.3;">';
                html += '      <div style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; background: #f0f4f8; padding: 1.5px 4px; border-radius: 2px;" title="' + escapeHtml(tblMark) + '">' + escapeHtml(tblMark) + '</div>';
                html += '      <div style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; background: #f0f4f8; padding: 1.5px 4px; border-radius: 2px;">' + lblMark + '</div>';
                html += '      <div style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; background: #eef9ee; padding: 1.5px 4px; border-radius: 2px;" title="' + escapeHtml(ttlMark) + '">' + escapeHtml(ttlDisp) + '</div>';
                html += '      <div style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; background: #fff3e0; padding: 1.5px 4px; border-radius: 2px;">' + fltMark + '</div>';
                html += '    </div>';
            } else {
                html += '    <div style="height: 50px;"></div>';
            }
            
            html += '  </div>';
            html += '</div>';
        }
    }
    grid.innerHTML = html;
}

function handleExpand(r, c) {
    var posLabel = '[' + r + ',' + c + ']';
    var targetTile = document.querySelector('.tile-item[data-pos="' + posLabel + '"]');
    var selectedType = targetTile ? targetTile.querySelector('.tile-main-select').value : '';
    
    if (selectedType === '') {
        alert('種別を選択してから拡大ボタンを押してください。');
        return;
    }

    saveMainForm();
    
    bridge({ 
        code: 'PartsDefinition/screenBigger', 
        targetArea: 'AreaE', 
        row_pos: String(r), 
        col_pos: String(c), 
        selected_type: selectedType,
        parts_id: document.getElementById('parts_id').value,
        is_edit_mode_flag: document.getElementById('is_edit_mode_flag').value,
        parts_name: document.getElementById('parts_name').value,
        parts_description: document.getElementById('parts_description').value,
        rows: document.getElementById('rows').value,
        cols: document.getElementById('cols').value,
        tilesData: JSON.stringify(collectTilesData())
    });
}

function collectTilesData() {
    var currentTiles = [];
    document.querySelectorAll('.tile-item').forEach(function(item) {
        var label = item.getAttribute('data-pos');
        var mainSel = item.querySelector('.tile-main-select');
        if(label && mainSel) {
            currentTiles.push({ pos: label, type: mainSel.value });
        }
    });
    return currentTiles;
}

function saveMainForm() {
    var sessionData = sessionStorage.getItem(STORAGE_KEY_MAIN_FORM);
    var formData = sessionData ? JSON.parse(sessionData) : {};

    formData.parts_name = document.getElementById('parts_name')?.value || '';
    formData.parts_description = document.getElementById('parts_description')?.value || '';
    formData.rows = document.getElementById('rows')?.value || '1';
    formData.cols = document.getElementById('cols')?.value || '1';
    
    if (!formData.grids_config) {
        formData.grids_config = {};
    }
    
    collectTilesData().forEach(function(tile) {
        if (!formData.grids_config[tile.pos]) {
            formData.grids_config[tile.pos] = {};
        }
        formData.grids_config[tile.pos].layout_type = tile.type;
    });

    formData.tiles = collectTilesData();
    
    var finalJsonStr = JSON.stringify(formData);
    sessionStorage.setItem(STORAGE_KEY_MAIN_FORM, finalJsonStr);
    
    var hiddenEl = document.getElementById('grids_config_json');
    if (hiddenEl) {
        hiddenEl.value = JSON.stringify(formData.grids_config);
    }
}

function loadMainForm() {
    var sessionData = sessionStorage.getItem(STORAGE_KEY_MAIN_FORM);
    if (!sessionData) return;
    try {
        var formData = JSON.parse(sessionData);
        if (document.getElementById('parts_name') && formData.parts_name !== undefined) {
            document.getElementById('parts_name').value = formData.parts_name;
        }
        if (document.getElementById('parts_description') && formData.parts_description !== undefined) {
            document.getElementById('parts_description').value = formData.parts_description;
        }
        if (document.getElementById('rows') && formData.rows !== undefined) {
            document.getElementById('rows').value = formData.rows;
        }
        if (document.getElementById('cols') && formData.cols !== undefined) {
            document.getElementById('cols').value = formData.cols;
        }
        rebuildGrid();
    } catch (e) {
        rebuildGrid();
    }
}

function clearMainFormBackup() {
    sessionStorage.removeItem(STORAGE_KEY_MAIN_FORM);
}

/**
 * 登録実行アクション
 */
function sendToRegisterAction() {
    if(!confirm('入力した内容で登録してもよろしいですか？')) return;
    
    saveMainForm();
    
    var partsId = document.getElementById('parts_id').value;
    var isEditModeFlag = document.getElementById('is_edit_mode_flag').value;
    var partsName = document.getElementById('parts_name').value;
    var partsDescription = document.getElementById('parts_description').value;
    var rows = document.getElementById('rows').value;
    var cols = document.getElementById('cols').value;
    
    var sessionData = sessionStorage.getItem(STORAGE_KEY_MAIN_FORM);
    var fullGridsConfigStr = "{}";
    if (sessionData) {
        try {
            var parsed = JSON.parse(sessionData);
            if (parsed.grids_config) {
                fullGridsConfigStr = JSON.stringify(parsed.grids_config);
            }
        } catch(e) {}
    }

    clearMainFormBackup();

    bridge({
        code: 'PartsDefinition/register',
        parts_id: partsId,
        is_edit_mode_flag: isEditModeFlag,
        parts_name: partsName,
        parts_description: partsDescription,
        rows: rows,
        cols: cols,
        tilesData: fullGridsConfigStr, 
        grids_config_json: fullGridsConfigStr
    });
}

function sendToImageAction() {
    var data = {
        parts_name: document.getElementById('parts_name').value,
        rows: document.getElementById('rows').value,
        cols: document.getElementById('cols').value,
        tiles: collectTilesData()
    };
    var f = document.createElement('form');
    f.method = 'POST';
    f.action = 'PartsDefinition/image';
    f.target = '_blank';
    var inp = document.createElement('input');
    inp.type = 'hidden';
    inp.name = 'previewData';
    inp.value = JSON.stringify(data);
    f.appendChild(inp);
    document.body.appendChild(f);
    f.submit();
    document.body.removeChild(f);
}

function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
}

// 💡 複雑な条件分岐を廃止し、最優先で現在のPHP変数（最新情報）を同期させて描画する形にシンプル化
(function() {
    setTimeout(function() {
        var editConfigJson = '<?= !empty($grids_config_json) ? $grids_config_json : "{}" ?>';
        var sessionData = sessionStorage.getItem(STORAGE_KEY_MAIN_FORM);
        
        // 1. まずDB（PHP）から最新情報があればそれを最優先でセッションに強制マージ
        if (editConfigJson !== '{}' && editConfigJson !== '') {
            try {
                var gridsConfig = JSON.parse(editConfigJson);
                var formData = sessionData ? JSON.parse(sessionData) : {};
                
                formData.grids_config = gridsConfig;
                sessionStorage.setItem(STORAGE_KEY_MAIN_FORM, JSON.stringify(formData));
            } catch(e) {
                console.error("PHPデータの解析に失敗しました", e);
            }
        }
        
        // 2. セッションがあればロード、なければデフォルト値で初期化
        if (sessionStorage.getItem(STORAGE_KEY_MAIN_FORM)) {
            loadMainForm();
        } else {
            var rowsEl = document.getElementById('rows');
            var colsEl = document.getElementById('cols');
            if (rowsEl) rowsEl.value = "1";
            if (colsEl) colsEl.value = "1";
            rebuildGrid();
        }
    }, 20);
})();
</script>
