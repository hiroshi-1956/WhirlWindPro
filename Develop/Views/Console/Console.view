<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>wwProject Console</title>
    <style>
        /* 1. 基本レイアウト */
        html, body { height: 100%; margin: 0; padding: 0; overflow: hidden; font-family: sans-serif; background: #1e1e1e; color: #eee; }
        .console-wrapper { display: flex; flex-direction: column; height: 100vh; }
        
        /* エリアA, B (Header) */
        .header-row { display: flex; height: 50px; background: #2d2d2d; border-bottom: 1px solid #111; flex-shrink: 0; }
        #area-a { width: 250px; display: flex; align-items: center; justify-content: center; background: #333; font-weight: bold; border-right: 1px solid #111; color: #fff; }
        /* エリアB：背景を白（画像準拠）に変更 */
        #area-b { flex: 1; display: flex; align-items: center; padding: 0 15px; background: #fff; color: #333; justify-content: space-between; font-size: 13px; }
        
        .main-body { display: flex; flex: 1; overflow: hidden; }
        
        /* 2. エリアC (Side Nav) */
		#area-c {
		    width: 250px;
		    height: 100%; /* 親（main-body）の高さに合わせる */
		    flex-shrink: 0;
		    display: flex;
		    flex-direction: column; /* 縦並びにする */
		    background: #2c3e50;
		    border-right: 1px solid #111;
		}
		
		/* 念押し：すべてのリスト記号を消す（もし残っていてもこれで消えるはず） */
		#area-c * {
		    list-style: none !important;
		    list-style-type: none !important;
		}

        .navi-project-title { padding: 15px; font-weight: bold; background: #1a252f; border-bottom: 1px solid #111; color: #ecf0f1; }
        
        .menu-item { 
            padding: 12px 20px; cursor: pointer; display: flex; align-items: center;
            border-bottom: 1px solid #34495e; color: #ecf0f1; font-size: 14px;
        }
        .menu-item:hover { background: #3e4f5f; }
        .menu-item.active { background: #3498db; }
        
        /* ProjectLockを最下部へ */
        .navi-footer { margin-top: auto; background: #1a252f; border-top: 1px solid #111; }

        /* 3. エリアD, E, F */
        .right-container { flex: 1; display: flex; flex-direction: column; }
        .content-row { display: flex; flex: 1; overflow: hidden; }
        #area-d { width: 100px; background: #fdfdfd; border-right: 1px solid #ddd; overflow-y: auto; color: #333; }
        #area-e { flex: 1; background: #fff; overflow-y: auto; color: #333; }
        #area-f { height: 45px; background: #1a7a42; color: #fff; display: flex; align-items: center; padding: 0 10px; font-size: 12px; }
    </style>
</head>
<body>

<div class="console-wrapper">
    <header class="header-row">
        <div id="area-a">WhirlWindPro</div>
        <!-- 修正：{$Area_B}を削除。初期状態は空にします -->
        <div id="area-b"></div>
    </header>

    <main class="main-body">
        <!-- 修正：中身の ProjectLock 残骸を完全に削除しました -->
        <aside id="area-c"></aside>
        
        <div class="right-container">
            <div class="content-row">
                <nav id="area-d"></nav>
                <section id="area-e"></section>
            </div>
            <footer id="area-f"></footer>
        </div>
    </main>
</div>

<script>

	function bridge(payload) {
	    const body = new URLSearchParams(payload).toString();
	    fetch('ServerBridgeAction', {
	        method: 'POST',
	        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
	        body: body
	    })
	    .then(res => res.json())
	    .then(data => {
	        // 届いたデータを各エリアに流し込む（ここは固定）
	        if (data.areas) {
	            Object.entries(data.areas).forEach(([areaId, html]) => {
	                const target = document.getElementById(`area-${areaId.toLowerCase()}`);
	                if (target) target.innerHTML = html;
	            });
	        }
	    });
	}
	
	// 画面表示後、即座に areaInitialAction を起動する
	window.onload = () => bridge({ code: 'Console/areaInitial' });
</script>

</body>
</html>
