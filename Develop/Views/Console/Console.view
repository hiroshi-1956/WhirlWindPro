<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>wwProject Console</title>
    <style>
        /* 全体：スクロールを抑制し、100vhに固定 */
        html, body { 
            height: 100%; margin: 0; padding: 0; overflow: hidden; 
            font-family: "Segoe UI", "Meiryo", sans-serif; background-color: #1e1e1e; color: #eee;
        }

        /* メインコンテナ：縦方向のFlex */
        .console-wrapper { display: flex; flex-direction: column; height: 100vh; width: 100vw; }

        /* ヘッダー(A+B)：高さ 50px 固定 */
        .header-row { 
            display: flex; height: 50px; flex-shrink: 0; 
            background: #2d2d2d; border-bottom: 1px solid #111; 
        }
        #area-a { 
            width: 250px; flex-shrink: 0; display: flex; align-items: center; justify-content: center;
            background: #333; font-weight: bold; border-right: 1px solid #111; font-size: 18px; color: #fff;
        }
        #area-b { 
            flex: 1; display: flex; align-items: center; padding: 0 15px; 
            font-size: 13px; justify-content: space-between; background: #f8f9fa; color: #333;
        }

        /* メインボディ(C, D, E)：残りの高さを占有 */
        .main-body { display: flex; flex: 1; overflow: hidden; }

        /* エリアC(サイドナビ)：エリアAと幅を 250px で統一 */
        #area-c { 
            width: 250px; flex-shrink: 0; background: #2c3e50; 
            border-right: 1px solid #111; overflow-y: auto; color: #fff;
        }

        /* ワークスペースグループ(D+E+F) */
        .right-container { flex: 1; display: flex; flex-direction: column; min-width: 0; }
        
        /* エリアDとEを横に並べる */
        .content-row { display: flex; flex: 1; overflow: hidden; }

        /* エリアD(リスト)：幅 280px 固定 */
        #area-d { 
            width: 280px; flex-shrink: 0; background: #fdfdfd; 
            border-right: 1px solid #ddd; overflow-y: auto; color: #333;
        }

        /* エリアE(メイン)：可変 */
        #area-e { 
            flex: 1; background: #fff; overflow-y: auto; color: #333;
        }

        /* エリアF(ステータスバー)：高さ 32px 固定 */
		#area-f {
			height: 32px !important;
		    padding: 0 !important;
		    margin: 0 !important;
		    background-color: transparent !important;
		    overflow: hidden;
		}

        /* スクロールバーのカスタマイズ */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; }
        ::-webkit-scrollbar-thumb { background: #888; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #555; }
    </style>
</head>
<body>

<div class="console-wrapper">
    <header class="header-row">
        <!-- 初期表示はPHP変数を展開（図の1枚目→2枚目） -->
        <div id="area-a">{$Area_A}</div>
        <div id="area-b">{$Area_B}</div>
    </header>

    <main class="main-body">
        <aside id="area-c">{$Area_C}</aside>
        
        <div class="right-container">
            <div class="content-row">
                <nav id="area-d">{$Area_D}</nav>
                <section id="area-e">{$Area_E}</section>
            </div>
            <footer id="area-f">{$Area_F}</footer>
        </div>
    </main>
</div>

<script>

	bindGlobalEvents() {
	    const container = document.getElementById('area-c-content');
	    if (!container) return;
	
	    container.onclick = (e) => {
	        const item = e.target.closest('.menu-item');
	        if (item) {
	            // dataset.name をサーバーに送る
	            this.updateConsole('clickProjectNabi', item.dataset.name);
	        }
	    };
	}
	
	// 器（container）だけを更新
	reflectAreas(response) {
	    const target = document.getElementById('area-c-replaceable-container');
	    if (target && response.Area_C) {
	        target.innerHTML = response.Area_C;
	    }
	}

</script>

</body>
</html>
